@startuml US071-class-diagram
skinparam classAttributeIconSize 0

package "UI Layer" {
  class DecommissionAircraftUI <<boundary>> {
    + doShow() : void
  }
}

package "Application Layer" {
  class DecommissionAircraftController <<control>> {
    - authorizationService : AuthorizationService
    - decommissionAircraftService : DecommissionAircraftService
    + DecommissionAircraftController(authz, svc)
    + decommissionAircraft(registration : String) : void
  }

  class DecommissionAircraftService <<service>> {
    - aircraftRepository : AircraftRepository
    - userSessionService : UserSessionService
    + DecommissionAircraftService(aircraftRepo, sessionSvc)
    + decommissionAircraft(registration : AircraftRegistration) : void
  }
}

package "Domain Layer" {
  class Aircraft <<entity>> <<AggregateRoot>> {
    - registration : AircraftRegistration
    - company : AirTransportCompany
    - cabinConfiguration : CabinConfiguration
    - crewCount : int
    - operationalStatus : OperationalStatus
    + Aircraft(registration, company,\n cabinConfig, crewCount)
    + identity() : AircraftRegistration
    + company() : AirTransportCompany
    + operationalStatus() : OperationalStatus
    + decommission() : void
    + isActive() : boolean
  }

  enum OperationalStatus <<ValueObject>> {
    ACTIVE
    DECOMMISSIONED
  }

  class AircraftRegistration <<ValueObject>> <<EmbeddedId>> {
    - registration : String
    + AircraftRegistration(registration : String)
    + registration() : String
  }

  interface AircraftRepository <<Repository>> {
    + save(aircraft : Aircraft) : Aircraft
    + ofIdentity(reg : AircraftRegistration) : Optional<Aircraft>
    + findActiveByCompany(company : AirTransportCompany) : Iterable<Aircraft>
    + hasPendingFlights(reg : AircraftRegistration) : boolean
  }

  class UserSessionService <<service>> {
    + currentUserCompany() : AirTransportCompany
  }
}

package "Infrastructure Layer" {
  class JpaAircraftRepository <<infrastructure>> {
    + save(aircraft : Aircraft) : Aircraft
    + ofIdentity(reg : AircraftRegistration) : Optional<Aircraft>
    + findActiveByCompany(company : AirTransportCompany) : Iterable<Aircraft>
    + hasPendingFlights(reg : AircraftRegistration) : boolean
  }
}

DecommissionAircraftUI --> DecommissionAircraftController
DecommissionAircraftController --> DecommissionAircraftService
DecommissionAircraftController --> AuthorizationService

DecommissionAircraftService --> AircraftRepository
DecommissionAircraftService --> UserSessionService

Aircraft *-- AircraftRegistration
Aircraft *-- OperationalStatus

JpaAircraftRepository ..|> AircraftRepository

note on link
  hasPendingFlights() queries
  FlightPlan records for any
  non-terminal status associated
  with the given registration
end note

@enduml