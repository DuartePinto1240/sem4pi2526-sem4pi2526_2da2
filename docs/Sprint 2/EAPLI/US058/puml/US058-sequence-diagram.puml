@startuml SD_US058
skinparam monochrome true
skinparam shadowing false
autonumber

actor "Backoffice Operator" as Op
participant ":RemoveEngineModelFromAircraftUI" as UI
participant ":RemoveEngineModelFromAircraftController" as Ctrl
participant "aircraftModelRepo:AircraftModelRepository" as AircraftModelRepo
participant "aircraftRepo:AircraftRepository" as AircraftRepo
participant "aircraft:AircraftModel" as Aircraft

Op -> UI : Selects "Remove Engine Model from Aircraft Model"
activate UI

UI -> Ctrl : getAircraftModels()
activate Ctrl
Ctrl -> AircraftModelRepo : findAll()
activate AircraftModelRepo
AircraftModelRepo --> Ctrl : aircraftModels
deactivate AircraftModelRepo
Ctrl --> UI : aircraftModels
deactivate Ctrl

UI --> Op : Presents list of aircraft models
Op -> UI : Selects aircraft model (aircraftModelId)

UI -> Ctrl : getCertifiedEngines(aircraftModelId)
activate Ctrl
Ctrl -> AircraftModelRepo : findById(aircraftModelId)
activate AircraftModelRepo
AircraftModelRepo --> Ctrl : aircraftModel
deactivate AircraftModelRepo
Ctrl --> UI : aircraftModel.certifiedEngines()
deactivate Ctrl

UI --> Op : Presents certified engine models
Op -> UI : Selects engine model to remove (engineModelId)

UI -> Ctrl : removeEngineModelFromAircraft(aircraftModelId, engineModelId)
activate Ctrl

Ctrl -> AircraftModelRepo : findById(aircraftModelId)
activate AircraftModelRepo
AircraftModelRepo --> Ctrl : aircraftModel
deactivate AircraftModelRepo

note right of Ctrl : Enforces US058.2:\ncross-aggregate check via AircraftRepository
Ctrl -> AircraftRepo : existsActiveAircraftUsing(aircraftModelId, engineModelId)
activate AircraftRepo
AircraftRepo --> Ctrl : result
deactivate AircraftRepo

alt active aircraft found
    Ctrl --> UI : throw ActiveAircraftBlocksRemovalException
    UI --> Op : Error: active aircraft using this engine model
else

    Ctrl -> Aircraft : removeCertifiedEngine(engineModel)
    activate Aircraft

    note right of Aircraft
        Enforces US058.1: engine must be
        in certifiedEngines list.
        Enforces US058.3: at least one
        engine must remain after removal.
    end note

    alt engine not certified
        Aircraft --> Ctrl : throw EngineNotCertifiedException
        Ctrl --> UI : throw EngineNotCertifiedException
        UI --> Op : Error: engine not certified for this aircraft model
    else only one engine remains
        Aircraft --> Ctrl : throw LastEngineRemovalException
        Ctrl --> UI : throw LastEngineRemovalException
        UI --> Op : Error: aircraft model must retain at least one engine
    else
        Aircraft --> Ctrl : ok
        deactivate Aircraft

        Ctrl -> AircraftModelRepo : save(aircraftModel)
        activate AircraftModelRepo
        AircraftModelRepo --> Ctrl : savedModel
        deactivate AircraftModelRepo

        Ctrl --> UI : savedModel
        deactivate Ctrl

        UI --> Op : Confirms successful removal
    end

end

deactivate UI

@enduml