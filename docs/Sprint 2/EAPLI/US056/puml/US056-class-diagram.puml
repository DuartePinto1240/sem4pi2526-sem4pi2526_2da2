@startuml CD_US056
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0

package "Presentation" {
    class CreateEngineModelUI <<Boundary>> {
    }
}

package "Application" {
    class CreateEngineModelController {
        + createEngineModel(name, manufacturer, type,\n  thrustStopped, thrustCruise, tsfc): EngineModel
    }
}

package "Domain" {
    class EngineModel <<Aggregate Root>> {
        - name: String
        - manufacturer: String
        + EngineModel(name, manufacturer, type, thrust, tsfc)
    }

    class EngineModelBuilder <<Builder>> {
        - name: String
        - manufacturer: String
        - motorizationType: MotorizationType
        - thrust: Thrust
        - tsfc: TSFC
        + withName(name): EngineModelBuilder
        + withManufacturer(manufacturer): EngineModelBuilder
        + withMotorizationType(type): EngineModelBuilder
        + withThrust(stopped, cruise): EngineModelBuilder
        + withTsfc(tsfc): EngineModelBuilder
        + build(): EngineModel
    }

    enum MotorizationType <<Enumeration>> {
        TURBOPROP
        TURBOFAN
        TURBOJET
        RAMJET
        ELECTRIC_PROPELLER
    }

    class Thrust <<Value Object>> {
        - seaLevelStopped: double
        - seaLevelCruise: double
        + Thrust(stopped, cruise)
    }

    class TSFC <<Value Object>> {
        - value: double
        + TSFC(value)
    }
}

package "Persistence" {
    interface EngineModelRepository <<Repository>> {
        + findByNameAndManufacturer(name, manufacturer): Optional<EngineModel>
        + save(model: EngineModel): EngineModel
    }

    class JpaEngineModelRepository <<JPA>> {
    }
}

' Relationships
CreateEngineModelUI ..> CreateEngineModelController : use
CreateEngineModelController ..> EngineModelBuilder : creates
CreateEngineModelController ..> EngineModelRepository : use
EngineModelBuilder ..> EngineModel : creates

EngineModel "1" *--> "1" MotorizationType
EngineModel "1" *--> "1" Thrust
EngineModel "1" *--> "1" TSFC

JpaEngineModelRepository ..|> EngineModelRepository

@enduml