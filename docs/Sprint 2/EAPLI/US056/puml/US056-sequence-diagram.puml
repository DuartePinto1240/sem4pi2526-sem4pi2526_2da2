@startuml SD_US056
skinparam monochrome true
skinparam shadowing false
autonumber

actor "Backoffice Operator" as Op
participant ":CreateEngineModelUI" as UI
participant ":CreateEngineModelController" as Ctrl
participant "repo:EngineModelRepository" as Repo
participant "builder:EngineModelBuilder" as Builder
participant "model:EngineModel" as Domain

activate Op
Op -> UI : Selects "Create Engine Model"
activate UI

UI --> Op : Presents motorization types and asks for data\n(name, manufacturer, type, thrustStopped, thrustCruise, tsfc)
Op -> UI : Inputs the requested data

UI -> Ctrl : createEngineModel(name, manufacturer, type,\n thrustStopped, thrustCruise, tsfc)
activate Ctrl

note right of Ctrl : Enforces US056.1: Uniqueness check
Ctrl -> Repo : findByNameAndManufacturer(name, manufacturer)
activate Repo
Repo --> Ctrl : result
deactivate Repo

alt model already exists
    Ctrl --> UI : throw DuplicateModelException
    UI --> Op : Error: engine model already exists
else

    Ctrl -> Builder** : new EngineModelBuilder()
    activate Builder
    Ctrl -> Builder : withName(name)
    Ctrl -> Builder : withManufacturer(manufacturer)
    Ctrl -> Builder : withMotorizationType(type)
    Ctrl -> Builder : withThrust(thrustStopped, thrustCruise)
    Ctrl -> Builder : withTsfc(tsfc)
    Ctrl -> Builder : build()

    note right of Builder : Enforces US056.2, .3, .4:\nmotorization type not null,\nthrust and TSFC strictly positive,\nthrustStopped < thrustCruise

    Builder -> Domain** : new EngineModel(name, manufacturer, type, thrust, tsfc)
    activate Domain
    Domain --> Builder : model
    deactivate Domain

    Builder --> Ctrl : model
    deactivate Builder

    Ctrl -> Repo : save(model)
    activate Repo
    Repo --> Ctrl : savedModel
    deactivate Repo

    Ctrl --> UI : savedModel
    deactivate Ctrl

    UI --> Op : Confirms successful registration

end

deactivate UI
deactivate Op

@enduml