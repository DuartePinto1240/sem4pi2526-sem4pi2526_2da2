@startuml
actor Administrator
participant RegisterUserUI as UI <<boundary>>
participant RegisterUserController as CTRL <<control>>
participant ValidEmailDomains as VED <<utility>>
participant "user:User" as USER <<domain>>
participant PersistenceContext as PCON <<singleton>>
participant UserRepository as REPO <<repository>>

Administrator -> UI : doShow()
UI -> Administrator : requests user data (field by field)

note right of UI
  Each field validated immediately.
  On error: re-prompt that field only.
end note

Administrator -> UI : name, email, phone, staffNumber, password, clearanceExpiry
UI -> VED : isValid(email)
VED --> UI : true / false
UI -> PCON : getInstance().userRepository()
PCON --> UI : repo
UI -> REPO : ofIdentity(email) [uniqueness checks]
REPO --> UI : empty

UI -> CTRL : registerUser(email, name, phone, password, staffNumber, clearanceExpiry)
activate CTRL
CTRL -> VED : isValid(email)
CTRL -> REPO : ofIdentity(email)
REPO --> CTRL : empty
CTRL -> USER : new User(email, name, phone, password, staffNumber, clearanceExpiry)
activate USER
USER -> USER : validate all fields
USER -> USER : role = "USER"
USER -> USER : nextSkillsAssessmentDate = today + 5 years
USER --> CTRL : user
deactivate USER
CTRL -> REPO : save(user)
CTRL --> UI : user
deactivate CTRL

UI --> Administrator : displays success (name, email, role, clearance, assessment)
@enduml
