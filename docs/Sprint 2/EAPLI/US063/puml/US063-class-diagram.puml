@startuml CD_US063
title US063 – Edit a Customer's Collaborator\n(Class Diagram)

skinparam linetype ortho
skinparam class {
    BackgroundColor<<AggregateRoot>> #D0C8F8
    BorderColor<<AggregateRoot>>     #534AB7
    BackgroundColor<<Entity>>        #C2EAD8
    BorderColor<<Entity>>            #0F6E56
    BackgroundColor<<ValueObject>>   #FAE8C0
    BorderColor<<ValueObject>>       #854F0B
    BackgroundColor<<Controller>>    #FADADD
    BorderColor<<Controller>>        #A03040
    BackgroundColor<<Repository>>    #D8EAF8
    BorderColor<<Repository>>        #1A5276
    BackgroundColor<<Interface>>     #EDEDED
    BorderColor<<Interface>>         #555555
}

'Presentation
package "Presentation" {
    class EditCollaboratorUI {
        + run() : void
        - displayCustomerList(customers : List<CustomerDTO>) : void
        - displayCollaborators(collaborators : List<CollaboratorDTO>) : void
        - promptEditableFields(current : CollaboratorDTO) : EditCollaboratorDTO
        - showSuccess() : void
        - showError(message : String) : void
    }
}

'Application
package "Application" {
    class EditCollaboratorController <<Controller>> {
        - customerRepository : CustomerRepository
        - userRepository : UserRepository
        + getAvailableCustomers() : List<CustomerDTO>
        + listCollaborators(customerId : Long,\n  customerType : CustomerType) : List<CollaboratorDTO>
        + editCollaborator(customerId : Long,\n  customerType : CustomerType,\n  currentEmail : String,\n  newEmail : String,\n  newPhone : String) : void
    }

    note right of EditCollaboratorController
      Method signature only accepts
      email and phoneNumber — name and
      position are structurally excluded,
      making them impossible to change.
    end note

    class CustomerDTO {
        + id : Long
        + name : String
        + type : CustomerType
    }

    class CollaboratorDTO {
        + email : String
        + name : String
        + position : String
    }

    class EditCollaboratorDTO {
        + newEmail : String
        + newPhoneNumber : String
    }

    enum CustomerType {
        AIR_TRANSPORT_COMPANY
        AIR_CONTROL_AREA
    }
}

'Repository
package "Repository" {
    interface UserRepository <<Interface>> {
        + findByEmail(email : String) : Optional<User>
        + save(user : User) : User
    }

    interface CustomerRepository <<Interface>> {
        + findAllAirTransportCompanies() : List<AirTransportCompany>
        + findAllAirControlAreas() : List<AirControlArea>
        + findAirTransportCompanyById(id : Long) : Optional<AirTransportCompany>
        + findAirControlAreaById(id : Long) : Optional<AirControlArea>
        + save(company : AirTransportCompany) : AirTransportCompany
        + save(area : AirControlArea) : AirControlArea
    }
}

'Relationships
EditCollaboratorUI         ..> EditCollaboratorController : uses
EditCollaboratorController ..> UserRepository             : uses
EditCollaboratorController ..> CustomerRepository         : uses
EditCollaboratorController ..> CustomerDTO                : creates
EditCollaboratorController ..> CollaboratorDTO            : creates
EditCollaboratorController ..> CustomerType               : uses
EditCollaboratorUI         ..> EditCollaboratorDTO        : creates

@enduml
