@startuml
left to right direction

actor "Any User" as U
actor "Administrator" as A
actor "Regular User (Backoffice Operator)" as RU

rectangle "Authentication & Authorization (US030)" {
  usecase "Login" as UC_Login
  usecase "Logout" as UC_Logout
  usecase "Verify Credentials\n& Active Status" as UC_Verify
  usecase "Access Admin\nFunctionalities" as UC_Admin
  usecase "Access User\nFunctionalities" as UC_User
}

U --> UC_Login
U --> UC_Logout

A --> UC_Admin
RU --> UC_User

UC_Login ..> UC_Verify : <<include>>
UC_Admin ..> UC_Login : <<extend>>\n[requires ADMIN role]
UC_User  ..> UC_Login : <<extend>>\n[requires login]

note bottom of UC_Verify
  Checks via AuthzRegistry:
  1. SystemUser exists
  2. Password matches
  3. Account is active (isActive())
end note

@enduml
