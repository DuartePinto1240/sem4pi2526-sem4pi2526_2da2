@startuml
actor "Weather Person" as WP
participant RegisterWeatherDataUI as UI <<boundary>>
participant RegisterWeatherDataController as CTRL <<control>>
participant AuthorizationService as AUTHZ <<service>>
participant AirControlAreaRepository as AREA_REPO <<repository>>
participant WeatherDataRepository as WD_REPO <<repository>>
participant "wd:WeatherData" as WD <<entity>>

WP -> UI : doShow()

UI -> CTRL : allAreas()
CTRL -> AUTHZ : ensureAuthenticatedUserHasAnyOf(WEATHER_PERSON)
activate AUTHZ
AUTHZ --> CTRL : ok
deactivate AUTHZ
CTRL -> AREA_REPO : findAll()
activate AREA_REPO
AREA_REPO --> CTRL : Iterable<AirControlArea>
deactivate AREA_REPO
CTRL --> UI : Iterable<AirControlArea>
UI --> WP : displays list of areas

WP -> UI : enters areaCode

UI -> CTRL : existingWeatherDataForArea(areaCode)
CTRL -> WD_REPO : findByArea(AirControlAreaCode)
activate WD_REPO
WD_REPO --> CTRL : Iterable<WeatherData>
deactivate WD_REPO
CTRL --> UI : Iterable<WeatherData>
UI --> WP : displays existing sub-areas

WP -> UI : enters subMinLat, subMaxLat, subMinLon, subMaxLon,\n  minAltitude, maxAltitude,\n  startDateTime, endDateTime,\n  windDirection, windSpeed

UI -> CTRL : registerWeatherData(areaCode, subMinLat, subMaxLat,\n  subMinLon, subMaxLon, minAltitude, maxAltitude,\n  startDateTime, endDateTime, windDirection, windSpeed)
activate CTRL

CTRL -> AREA_REPO : ofIdentity(AirControlAreaCode)
activate AREA_REPO
AREA_REPO --> CTRL : Optional<AirControlArea>
deactivate AREA_REPO

alt area not found
  CTRL --> UI : throws IllegalArgumentException("area does not exist")
  UI --> WP : "ERROR: Air control area does not exist"
else area found
  CTRL -> CTRL : new GeographicBoundary(subMinLat, subMaxLat, subMinLon, subMaxLon)
  CTRL -> CTRL : new AltitudeRange(minAltitude, maxAltitude)
  CTRL -> CTRL : new WeatherSubArea(subBoundary, altRange)

  alt sub-area not inside parent boundary
    CTRL --> UI : throws IllegalArgumentException("sub-area outside boundary")
    UI --> WP : "ERROR: Sub-area must lie inside the air control area"
  else sub-area valid
    CTRL -> CTRL : new ObservationPeriod(startDateTime, endDateTime)
    CTRL -> CTRL : new WindCondition(windDirection, windSpeed)

    CTRL -> WD_REPO : existsConflicting(areaCode, subArea, period)
    activate WD_REPO
    WD_REPO --> CTRL : boolean
    deactivate WD_REPO

    alt conflict exists
      CTRL --> UI : throws IllegalArgumentException("conflicting record")
      UI --> WP : "ERROR: Conflicting weather record already exists"
    else no conflict
      CTRL -> WD ** : new WeatherData(areaCode, subArea, period, wind)
      CTRL -> WD_REPO : save(wd)
      activate WD_REPO
      WD_REPO --> CTRL : wd (persisted)
      deactivate WD_REPO

      CTRL --> UI : WeatherData (persisted)
      deactivate CTRL
      UI --> WP : "Weather data registered successfully"
    end
  end
end

@enduml
