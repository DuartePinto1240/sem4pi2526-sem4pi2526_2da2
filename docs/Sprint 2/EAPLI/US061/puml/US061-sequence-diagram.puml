@startuml SD_US061
title US061 – Add a Customer's Collaborator\n(Sequence Diagram)

skinparam sequence {
    ActorBorderColor #534AB7
    ActorBackgroundColor #D0C8F8
    ParticipantBorderColor #0F6E56
    ParticipantBackgroundColor #C2EAD8
    LifeLineBorderColor #854F0B
    NoteBackgroundColor #FAE8C0
    NoteBorderColor #854F0B
    ArrowColor #333333
}

actor "Backoffice Operator" as BO
participant "AddCollaboratorUI" as UI
participant "AddCollaboratorController" as CTRL
participant "CustomerRepository" as CREPO
participant "UserRepository" as UREPO
participant "AirTransportCompany\n/ AirControlArea" as CUSTOMER
participant "ATCC\n/ FlightControlOperator" as COLLAB
participant "User" as USER


BO -> UI : requests to add a collaborator
activate UI

UI -> CTRL : getAvailableCustomers()
activate CTRL
CTRL -> CREPO : findAllAirTransportCompanies()
CREPO --> CTRL : List<AirTransportCompany>
CTRL -> CREPO : findAllAirControlAreas()
CREPO --> CTRL : List<AirControlArea>
CTRL --> UI : List<CustomerDTO>
deactivate CTRL

UI --> BO : displays customer list

BO -> UI : selects customer + submits\n(email, name, phone, position)

UI -> CTRL : addCollaborator(customerId, customerType,\n  email, name, phone, position)
activate CTRL

CTRL -> UREPO : findByEmail(email)
UREPO --> CTRL : result

alt email already exists
    CTRL --> UI : throws / error message
    UI --> BO : "Email already registered"

else email is unique

    CTRL -> USER : create(email, name, phone)
    activate USER
    USER --> CTRL : newUser
    deactivate USER
    CTRL -> UREPO : save(newUser)
    UREPO --> CTRL : savedUser

    CTRL -> CREPO : findById(customerId, customerType)
    CREPO --> CTRL : customer

    CTRL -> CUSTOMER : addCollaborator(email, name, position)
    activate CUSTOMER
    CUSTOMER -> COLLAB : new (email, name, position, active=true)
    activate COLLAB
    COLLAB --> CUSTOMER : collaborator
    deactivate COLLAB
    CUSTOMER --> CTRL : updated collaborator
    deactivate CUSTOMER

    CTRL -> CREPO : save(customer)
    CREPO --> CTRL : ok

    CTRL --> UI : success
    UI --> BO : "Collaborator added successfully"
end

deactivate CTRL
deactivate UI

@enduml
