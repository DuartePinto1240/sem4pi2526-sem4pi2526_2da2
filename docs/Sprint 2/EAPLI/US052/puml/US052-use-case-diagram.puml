@startuml US052-use-case-diagram
left to right direction

actor "Backoffice Operator" as BO
actor "System Bootstrap" as BOOT

rectangle "Backoffice Configuration Module" {
  usecase "Create Airport" as UC_Create
  usecase "Authenticate & Authorize" as UC_Auth
  usecase "Validate Airport Data" as UC_Validate
  usecase "Check Code Uniqueness" as UC_Unique
  usecase "Verify Air Control Area Exists" as UC_VerifyArea
  usecase "Persist Airport" as UC_Persist
}

BO --> UC_Create
BOOT --> UC_Persist : <<direct>>

UC_Create ..> UC_Auth : <<include>>
UC_Create ..> UC_Validate : <<include>>
UC_Create ..> UC_Unique : <<include>>
UC_Create ..> UC_VerifyArea : <<include>>
UC_Create ..> UC_Persist : <<include>>

note bottom of UC_Auth
  Enforced by
  AuthorizationService
  Role: BACKOFFICE_OPERATOR
end note

note bottom of UC_Validate
  ICAO: exactly 4 letters
  IATA: exactly 3 letters
  Lat in [-90, 90]
  Lon in [-180, 180]
  Name and town non-blank
end note

note bottom of UC_Unique
  ICAO code must be unique
  IATA code must be unique
  (both worldwide)
end note

note bottom of UC_VerifyArea
  Referenced AirControlArea
  must exist in the system
end note

@enduml