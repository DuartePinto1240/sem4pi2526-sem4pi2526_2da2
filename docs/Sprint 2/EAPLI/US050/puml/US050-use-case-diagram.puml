@startuml US050-use-case-diagram
left to right direction

actor "Backoffice Operator" as BO
actor "System Bootstrap" as BOOT

rectangle "Backoffice Configuration Module" {
  usecase "Register Air Control Area" as UC_Register
  usecase "Authenticate & Authorize" as UC_Auth
  usecase "Validate Area Data" as UC_Validate
  usecase "Check Code Uniqueness" as UC_Unique
  usecase "Persist Air Control Area" as UC_Persist
}

BO --> UC_Register
BOOT --> UC_Persist : <<direct>>

UC_Register ..> UC_Auth : <<include>>
UC_Register ..> UC_Validate : <<include>>
UC_Register ..> UC_Unique : <<include>>
UC_Register ..> UC_Persist : <<include>>

note bottom of UC_Auth
  Enforced by
  AuthorizationService
  Role: BACKOFFICE_OPERATOR
end note

note bottom of UC_Validate
  Area code non-blank
  Name non-blank
  Boundary >= 3 coordinates
  Lat in [-90, 90]
  Lon in [-180, 180]
end note

note bottom of UC_Unique
  Area code must not
  already exist in the
  system
end note

@enduml






