@startuml US050-class-diagram
skinparam classAttributeIconSize 0

package "UI Layer" {
  class RegisterAirControlAreaUI <<boundary>> {
    + doShow() : void
  }
}

package "Application Layer" {
  class RegisterAirControlAreaController <<control>> {
    - authorizationService : AuthorizationService
    - registerAirControlAreaService : RegisterAirControlAreaService
    + RegisterAirControlAreaController(authz, svc)
    + registerAirControlArea(code : String,\n name : String,\n coordinates : List<double[]>) : AirControlAreaDTO
  }

  class RegisterAirControlAreaService <<service>> {
    - airControlAreaRepository : AirControlAreaRepository
    - airControlAreaFactory : AirControlAreaFactory
    + RegisterAirControlAreaService(repo, factory)
    + registerAirControlArea(code : AirControlAreaCode,\n name : AreaName,\n boundary : GeographicBoundary) : AirControlArea
  }
}

package "Domain Layer" {
  class AirControlArea <<entity>> <<AggregateRoot>> {
    - code : AirControlAreaCode
    - name : AreaName
    - boundary : GeographicBoundary
    + AirControlArea(code, name, boundary)
    + identity() : AirControlAreaCode
    + name() : AreaName
    + boundary() : GeographicBoundary
  }

  class AirControlAreaFactory <<factory>> {
    + create(code : AirControlAreaCode,\n name : AreaName,\n boundary : GeographicBoundary) : AirControlArea
  }

  class AirControlAreaCode <<ValueObject>> <<EmbeddedId>> {
    - code : String
    + AirControlAreaCode(code : String)
    + code() : String
  }

  class AreaName <<ValueObject>> {
    - name : String
    + AreaName(name : String)
    + name() : String
  }

  class GeographicBoundary <<ValueObject>> {
    - coordinates : List<Coordinate>
    + GeographicBoundary(coordinates : List<Coordinate>)
    + coordinates() : List<Coordinate>
    + contains(point : Coordinate) : boolean
  }

  class Coordinate <<ValueObject>> {
    - latitude : double
    - longitude : double
    + Coordinate(latitude : double, longitude : double)
    + latitude() : double
    + longitude() : double
  }

  interface AirControlAreaRepository <<Repository>> {
    + save(area : AirControlArea) : AirControlArea
    + ofIdentity(code : AirControlAreaCode) : Optional<AirControlArea>
    + containsOfIdentity(code : AirControlAreaCode) : boolean
    + findAll() : Iterable<AirControlArea>
  }
}

package "Infrastructure Layer" {
  class JpaAirControlAreaRepository <<infrastructure>> {
    + save(area : AirControlArea) : AirControlArea
    + ofIdentity(code : AirControlAreaCode) : Optional<AirControlArea>
    + containsOfIdentity(code : AirControlAreaCode) : boolean
    + findAll() : Iterable<AirControlArea>
  }
}

package "Bootstrap" {
  class MasterDataBootstrap <<bootstrap>> {
    + execute() : void
  }
}

RegisterAirControlAreaUI --> RegisterAirControlAreaController
RegisterAirControlAreaController --> RegisterAirControlAreaService
RegisterAirControlAreaController --> AuthorizationService

RegisterAirControlAreaService --> AirControlAreaFactory
RegisterAirControlAreaService --> AirControlAreaRepository

AirControlAreaFactory ..> AirControlArea : <<creates>>

AirControlArea *-- AirControlAreaCode
AirControlArea *-- AreaName
AirControlArea *-- GeographicBoundary
GeographicBoundary *-- Coordinate

JpaAirControlAreaRepository ..|> AirControlAreaRepository

MasterDataBootstrap --> RegisterAirControlAreaService : <<uses>>

@enduml