@startuml US050-class-diagram
skinparam classAttributeIconSize 0

package "UI Layer" {
  class RegisterAirControlAreaUI <<boundary>> {
    + doShow() : boolean
    + headline() : String
  }
}

package "Application Layer" {
  class RegisterAirControlAreaController <<control>> {
    - repo : AirControlAreaRepository
    + RegisterAirControlAreaController()
    + allAreas() : Iterable<AirControlArea>
    + registerAirControlArea(areaCode : String,\n  name : String,\n  minLat : double, maxLat : double,\n  minLon : double, maxLon : double) : AirControlArea
  }
}

package "Domain Layer" {
  class AirControlArea <<entity>> <<AggregateRoot>> {
    - areaCode : AirControlAreaCode
    - name : String
    - boundary : GeographicBoundary
    + AirControlArea(areaCode : String, name : String,\n  boundary : GeographicBoundary)
    + identity() : AirControlAreaCode
    + name() : String
    + boundary() : GeographicBoundary
    + sameAs(other : Object) : boolean
  }

  class AirControlAreaCode <<ValueObject>> <<EmbeddedId>> {
    - code : String
    + AirControlAreaCode(code : String)
    + code() : String
    + compareTo(other : AirControlAreaCode) : int
  }

  class GeographicBoundary <<ValueObject>> <<Embeddable>> {
    - minLat : double
    - maxLat : double
    - minLon : double
    - maxLon : double
    - minAltitude : double
    - maxAltitude : double
    + GeographicBoundary(minLat, maxLat, minLon, maxLon)
    + GeographicBoundary(minLat, maxLat, minLon, maxLon,\n  minAltitude, maxAltitude)
    + minLat() : double
    + maxLat() : double
    + minLon() : double
    + maxLon() : double
    + minAltitude() : double
    + maxAltitude() : double
    + overlapsWith(other : GeographicBoundary) : boolean
  }

  interface AirControlAreaRepository <<Repository>> {
    + findAll() : Iterable<AirControlArea>
    + save(area : AirControlArea) : AirControlArea
    + ofIdentity(code : AirControlAreaCode) : Optional<AirControlArea>
    + containsOfIdentity(code : AirControlAreaCode) : boolean
    + existsByName(name : String) : boolean
    + existsOverlappingBoundary(boundary : GeographicBoundary) : boolean
  }
}

package "Infrastructure Layer" {
  class JpaAirControlAreaRepository <<infrastructure>> {
    + findAll() : Iterable<AirControlArea>
    + existsByName(name : String) : boolean
    + existsOverlappingBoundary(boundary : GeographicBoundary) : boolean
  }

  class InMemoryAirControlAreaRepository <<infrastructure>> {
    - areas : List<AirControlArea>
    + findAll() : Iterable<AirControlArea>
    + existsByName(name : String) : boolean
    + existsOverlappingBoundary(boundary : GeographicBoundary) : boolean
  }

}

package "Bootstrap" {
  class AirControlAreaBootstrapper <<bootstrap>> {
    + execute() : void
  }
}

RegisterAirControlAreaUI --> RegisterAirControlAreaController

RegisterAirControlAreaController --> AirControlAreaRepository

AirControlArea *-- AirControlAreaCode
AirControlArea *-- GeographicBoundary

JpaAirControlAreaRepository ..|> AirControlAreaRepository
InMemoryAirControlAreaRepository ..|> AirControlAreaRepository

AirControlAreaBootstrapper --> RegisterAirControlAreaController : <<uses>>

@enduml
