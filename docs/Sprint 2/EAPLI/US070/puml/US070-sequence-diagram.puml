@startuml
actor "ATCC" as ATCC
participant AddAircraftToFleetUI as UI <<boundary>>
participant AddAircraftToFleetController as CTRL <<control>>
participant AuthzRegistry as REG <<registry>>
participant AuthorizationService as AUTHZ <<service>>
participant PersistenceContext as PC <<registry>>
participant AircraftRepository as REPO <<repository>>
participant AircraftModelRepository as MODEL_REPO <<repository>>
participant "model:AircraftModel" as MODEL <<aggregate root>>
participant "cabin:CabinConfiguration" as CC <<value object>>
participant "status:OperationalStatus" as OS <<value object>>
participant "aircraft:Aircraft" as A <<aggregate root>>

ATCC -> UI : doShow()
UI -> ATCC : asks for registration, country, modelId, seatsPerClass, crewSize
ATCC -> UI : provides data
UI -> CTRL : addAircraft(registration, country, modelId, seatsPerClass, crewSize)

CTRL -> REG : authorizationService()
REG --> CTRL : authzService

CTRL -> AUTHZ : ensureAuthenticatedUserHasAnyOf(ATCC)
activate AUTHZ
AUTHZ --> CTRL : ok
deactivate AUTHZ

CTRL -> PC : repositories()
PC --> CTRL : repositoryFactory

CTRL -> REPO : existsByRegistration(registration)
activate REPO
REPO --> CTRL : false
deactivate REPO

CTRL -> MODEL_REPO : findById(modelId)
activate MODEL_REPO
MODEL_REPO --> CTRL : model
deactivate MODEL_REPO

CTRL -> MODEL : maxCapacity()
activate MODEL
MODEL --> CTRL : maxCapacity
deactivate MODEL

CTRL -> CC : new CabinConfiguration(seatsPerClass, crewSize)
activate CC
CC -> CC : validate(seatsPerClass, crewSize)
CC --> CTRL : cabin
deactivate CC

CTRL -> CC : totalSeats()
activate CC
CC --> CTRL : totalSeats
deactivate CC

CTRL -> CTRL : check totalSeats <= maxCapacity

CTRL -> OS : OperationalStatus.ACTIVE
OS --> CTRL : status

CTRL -> A : new Aircraft(registration, country, cabin, status, modelId, companyCode)
activate A
A -> A : validate(registration, country)
A --> CTRL : aircraft
deactivate A

CTRL -> REPO : save(aircraft)
activate REPO
REPO --> CTRL : savedAircraft
deactivate REPO

CTRL --> UI : savedAircraft

alt registration successful
    UI --> ATCC : show success message
else registration already exists
    CTRL --> UI : throw IllegalArgumentException
    UI --> ATCC : show error "Registration number already exists"
else model not found
    MODEL_REPO --> CTRL : throw IllegalArgumentException
    CTRL --> UI : propagate exception
    UI --> ATCC : show error "Aircraft model not found"
else seats exceed model capacity
    CTRL --> UI : throw IllegalArgumentException
    UI --> ATCC : show error "Total seats exceed model capacity"
else invalid registration format
    A --> CTRL : throw IllegalArgumentException
    CTRL --> UI : propagate exception
    UI --> ATCC : show error "Invalid registration format"
end
@enduml