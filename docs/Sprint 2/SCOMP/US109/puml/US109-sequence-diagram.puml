@startuml
actor "Flight Control Op." as FCO
participant SimulationReportUI as UI <<boundary>>
participant SimulationReportController as CTRL <<control>>
participant ReportFileReader as READER <<service>>
participant "dto:SimulationReportDTO" as DTO <<data>>

FCO -> UI : doShow()
UI -> FCO : asks for report file path
FCO -> UI : provides filePath

UI -> CTRL : readReport(filePath)
activate CTRL

CTRL -> READER : readFromFile(filePath)
activate READER

READER -> READER : open file
READER -> READER : parse header
READER -> READER : parse summary (flights, violations, result)
READER -> READER : parse flight statuses
READER -> READER : parse violation events
READER -> READER : close file

READER -> DTO : new SimulationReportDTO(...)
activate DTO
DTO --> READER : dto
deactivate DTO

READER --> CTRL : dto
deactivate READER

CTRL -> CTRL : formatReport(dto)
CTRL --> UI : formattedReport
deactivate CTRL

alt [report loaded successfully]
    UI --> FCO : display formatted report
    note right of FCO
      Shows:
      - Total flights
      - Total violations
      - PASS / FAIL result
      - Per-flight statuses
      - Violation events with
        timestamps, positions
        and velocity vectors
    end note
else [file not found or unreadable]
    UI --> FCO : show error "Report file not found"
else [report format invalid]
    UI --> FCO : show error "Could not parse report file"
end
@enduml