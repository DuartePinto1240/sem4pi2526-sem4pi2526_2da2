@startuml
actor "Backoffice Operator" as BO
participant RegisterAirTransportCompanyUI as UI <<boundary>>
participant RegisterAirTransportCompanyController as CTRL <<control>>
participant AuthzRegistry as REG <<registry>>
participant AuthorizationService as AUTHZ <<service>>
participant PersistenceContext as PC <<registry>>
participant AirTransportCompanyRepository as REPO <<repository>>
participant "company:AirTransportCompany" as ATC <<aggregate root>>
participant "code:CompanyCode" as CC <<value object>>

BO -> UI : doShow()
UI -> BO : asks for name, iata, icao
BO -> UI : provides name, iata, icao
UI -> CTRL : registerCompany(name, iata, icao)

CTRL -> REG : authorizationService()
REG --> CTRL : authzService

CTRL -> AUTHZ : ensureAuthenticatedUserHasAnyOf(BACKOFFICE_OPERATOR)
activate AUTHZ
AUTHZ --> CTRL : ok
deactivate AUTHZ

CTRL -> PC : repositories()
PC --> CTRL : repositoryFactory

CTRL -> REPO : existsByIata(iata)
activate REPO
REPO --> CTRL : false
deactivate REPO

CTRL -> REPO : existsByIcao(icao)
activate REPO
REPO --> CTRL : false
deactivate REPO

CTRL -> CC : new CompanyCode(iata, icao)
activate CC
CC -> CC : validate(iata, icao)
CC --> CTRL : code
deactivate CC

CTRL -> ATC : new AirTransportCompany(name, code)
activate ATC
ATC -> ATC : validate(name)
ATC --> CTRL : company
deactivate ATC

CTRL -> REPO : save(company)
activate REPO
REPO --> CTRL : savedCompany
deactivate REPO

CTRL --> UI : savedCompany

alt registration successful
    UI --> BO : show success message
else iata already exists
    CTRL --> UI : throw IllegalArgumentException
    UI --> BO : show error "IATA code already exists"
else icao already exists
    CTRL --> UI : throw IllegalArgumentException
    UI --> BO : show error "ICAO code already exists"
else invalid format
    CC --> CTRL : throw IllegalArgumentException
    CTRL --> UI : propagate exception
    UI --> BO : show error "Invalid code format"
end
@enduml