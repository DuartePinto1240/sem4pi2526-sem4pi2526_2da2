@startuml
actor User
participant MainMenu as MENU <<boundary>>
participant LoginController as CTRL <<control>>
participant AuthzRegistry as REG <<registry>>
participant AuthenticationService as AUTH <<service>>
participant AuthorizationService as AUTHZ <<service>>
participant PersistenceContext as PCON <<singleton>>
participant UserRepository as REPO <<repository>>

User -> MENU : starts application
MENU -> AUTHZ : session().isEmpty()
AUTHZ --> MENU : true (no session)
MENU --> User : shows public menu (Login / Exit only)

User -> MENU : chooses Login (option 1)
MENU -> User : asks for email and password
User -> MENU : provides email and password

MENU -> CTRL : login(email, password)
activate CTRL

' Step 1 — Framework authentication
CTRL -> REG : authenticationService()
REG --> CTRL : authService
CTRL -> AUTH : authenticate(email, password)
activate AUTH
AUTH -> AUTH : find SystemUser by username
AUTH -> AUTH : verify password
AUTH -> AUTH : check isActive()
AUTH --> CTRL : Optional<UserSession>
deactivate AUTH

alt framework authentication failed (wrong credentials / inactive)
    CTRL --> MENU : Optional.empty()
    MENU --> User : "Login failed: incorrect email/password or account inactive."
else framework authentication succeeded
    ' Step 2 — Domain clearance check
    CTRL -> PCON : getInstance().userRepository()
    PCON --> CTRL : repo
    CTRL -> REPO : ofIdentity(EmailAddress.valueOf(email))
    REPO --> CTRL : Optional<User>

    alt domain User found AND clearance expired
        CTRL -> AUTHZ : clearSession()
        CTRL --> MENU : Optional.empty()
        MENU --> User : "Login failed: incorrect email/password or account inactive."
    else clearance valid (or no domain User found)
        CTRL --> MENU : Optional<UserSession>
        MENU -> AUTHZ : isAuthenticatedUserAuthorizedTo(ADMIN)
        AUTHZ --> MENU : true / false
        MENU --> User : "Login successful. Welcome, {name}."
        MENU --> User : shows role-based menu
    end
end

deactivate CTRL

User -> MENU : chooses Logout (option 9)
MENU -> AUTHZ : clearSession()
MENU --> User : "Logged out. Goodbye, {name}."
MENU --> User : shows public menu again

note right of CTRL
  Single error message for all failure cases
  (security best practice).
  Skills assessment expiry has NO effect
  on login (per client clarification).
end note
@enduml
