@startuml
actor Administrator
participant ToggleUserUI as UI <<boundary>>
participant ListUsersController as LCTRL <<control>>
participant ToggleUserController as TCTRL <<control>>
participant AuthzRegistry as REG <<registry>>
participant UserManagementService as SVC <<service>>
participant "domainUser:User" as USER <<domain>>
participant UserRepository as REPO <<repository>>

Administrator -> UI : doShow()
UI -> LCTRL : allUsers()
LCTRL -> REPO : findByRole("BACKOFFICE_OPERATOR")
REPO --> LCTRL : BackOffice Operator users only
LCTRL -> LCTRL : convert to DTO + sort by name
LCTRL --> UI : sorted BackOffice Operators
UI --> Administrator : displays operator list with status

Administrator -> UI : enters email + choice (1=Enable / 2=Disable)

alt Disable (choice = 2)
    UI -> TCTRL : deactivateUser(email)
    activate TCTRL
    TCTRL -> REPO : ofIdentity(email)
    REPO --> TCTRL : domainUser
    TCTRL -> USER : getRole() [guard: must be BACKOFFICE_OPERATOR]
    TCTRL -> USER : isActive() [guard: already inactive?]

    ' Step 1: disable SystemUser via framework
    TCTRL -> REG : userService()
    REG --> TCTRL : svc
    TCTRL -> SVC : allUsers() [find SystemUser by email]
    SVC --> TCTRL : systemUser
    TCTRL -> SVC : deactivateUser(systemUser)
    note right of TCTRL
      Framework sets SystemUser.active = false.
      Subsequent login attempts will be refused
      by AuthenticationService.
    end note

    ' Step 2: mirror in domain User
    TCTRL -> USER : deactivate()
    USER -> USER : active = false
    TCTRL -> REPO : save(domainUser)
    TCTRL --> UI : true
    deactivate TCTRL

else Enable (choice = 1)
    UI -> TCTRL : activateUser(email)
    activate TCTRL
    TCTRL -> REPO : ofIdentity(email)
    REPO --> TCTRL : domainUser
    TCTRL -> USER : getRole() [guard: must be BACKOFFICE_OPERATOR]
    TCTRL -> USER : isActive() [guard: already active?]

    ' Step 1: activate SystemUser via framework
    TCTRL -> REG : userService()
    REG --> TCTRL : svc
    TCTRL -> SVC : allUsers() [find SystemUser by email]
    SVC --> TCTRL : systemUser
    TCTRL -> SVC : activateUser(systemUser)

    ' Step 2: mirror in domain User
    TCTRL -> USER : activate()
    USER -> USER : active = true
    TCTRL -> REPO : save(domainUser)
    TCTRL --> UI : true
    deactivate TCTRL
end

UI --> Administrator : confirms status change
@enduml
