@startuml US042-sequence-diagram
actor "Weather Person" as WP
participant ImportBulkWeatherDataUI as UI <<boundary>>
participant ImportBulkWeatherDataController as CTRL <<control>>
participant AuthorizationService as AUTHZ <<service>>
participant WeatherDataReaderFactory as READER_FACTORY <<factory>>
participant WeatherDataReader as READER <<Strategy>>
participant AirControlAreaRepository as AREA_REPO <<repository>>
participant WeatherDataFactory as WD_FACTORY <<factory>>
participant WeatherDataRepository as WD_REPO <<repository>>
participant ImportResult as RESULT

WP -> UI : doShow()
UI --> WP : prompts for file path

WP -> UI : filePath = "weather.csv"

UI -> CTRL : importWeatherData(filePath)
activate CTRL

CTRL -> AUTHZ : ensureAuthenticatedUserHasAnyOf(WEATHER_PERSON)
activate AUTHZ
AUTHZ --> CTRL : ok
deactivate AUTHZ

CTRL -> READER_FACTORY : getReader(filePath)
activate READER_FACTORY
note right of READER_FACTORY
  Simple Factory inspects the file extension and header line.
end note
READER_FACTORY --> CTRL : WeatherDataReader
deactivate READER_FACTORY

CTRL -> READER : read(filePath)
note right of READER
  Strategy pattern — the controller calls the same interface method regardless of the file format.
end note
activate READER
READER --> CTRL : List<WeatherDataImportDTO>
deactivate READER

CTRL -> RESULT ** : new ImportResult()

loop for each WeatherDataImportDTO dto in list

  CTRL -> AREA_REPO : ofIdentity(new AirControlAreaCode(dto.areaCode))
  activate AREA_REPO
  AREA_REPO --> CTRL : Optional<AirControlArea>
  deactivate AREA_REPO

  alt area not found
    CTRL -> RESULT : recordFailure("line N – area not found")

  else area found

    CTRL -> WD_FACTORY : create(dto)
    activate WD_FACTORY
    note right of WD_FACTORY
      Domain Factory — constructs all intermediate value objects
    end note
    WD_FACTORY --> CTRL : WeatherData
    deactivate WD_FACTORY

    alt value object invariant violated
      CTRL -> RESULT : recordFailure("line N – " + e.getMessage())

    else aggregate constructed

      alt sub-area outside parent boundary
        CTRL -> RESULT : recordFailure("line N – sub-area outside boundary")

      else boundary ok

        CTRL -> WD_REPO : existsConflicting(areaCode, subArea, period)
        activate WD_REPO
        WD_REPO --> CTRL : boolean
        deactivate WD_REPO

        alt conflict exists
          CTRL -> RESULT : recordFailure("line N – conflicting record")

        else no conflict
          CTRL -> WD_REPO : save(weatherData)
          activate WD_REPO
          WD_REPO --> CTRL : weatherData (persisted)
          deactivate WD_REPO
          CTRL -> RESULT : recordSuccess()
        end
      end
    end
  end

end

CTRL --> UI : ImportResult
deactivate CTRL

UI --> WP : "Import complete: N imported, M rejected\n[error per rejected line]"

@enduml