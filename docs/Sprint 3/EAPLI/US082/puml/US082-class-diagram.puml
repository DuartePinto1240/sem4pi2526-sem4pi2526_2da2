@startuml

package "Presentation" {
  class InsertWeatherDataUI {
    +doShow(): boolean
    +headline(): String
    -getPilotFlightPlans(): List<FlightPlanDTO>
    -getAvailableWeatherData(areaCode: String): List<WeatherDataDTO>
    -insertWeatherData(flightPlanId: Long, weatherDataId: Long): void
  }
}

package "Application" {
  class InsertWeatherDataController {
    -flightPlanRepo: FlightPlanRepository
    -weatherRepo: WeatherDataRepository
    -areaRepo: AirControlAreaRepository
    +getPilotFlightPlans(pilotEmail: String): List<FlightPlanDTO>
    +getAvailableAreas(): List<AirControlAreaDTO>
    +getAvailableWeatherData(areaCode: String): List<WeatherDataDTO>
    +insertWeatherData(flightPlanId: Long, weatherDataId: Long): void
  }
  class FlightPlanDTO {
    +id: Long
    +flightId: String
    +flightType: String
    +status: FlightPlanStatus
    +routeDesignator: String
    +weatherDataId: Long
    +from(p: FlightPlan): FlightPlanDTO
  }
  class WeatherDataDTO {
    +id: Long
    +areaCode: String
    +startDateTime: LocalDateTime
    +endDateTime: LocalDateTime
    +windDirection: double
    +windSpeed: double
    +from(w: WeatherData): WeatherDataDTO
  }
  class AirControlAreaDTO {
    +areaCode: String
    +name: String
    +from(a: AirControlArea): AirControlAreaDTO
  }
}

package "Domain" {
  class FlightPlan <<AggregateRoot>> {
    -id: Long
    -flightId: String
    -status: FlightPlanStatus
    -weatherDataId: Long
    +addWeatherData(weatherDataId: Long): void
    +isModifiable(): boolean
  }
  enum FlightPlanStatus {
    DRAFT
    TESTED
  }
  class WeatherData <<AggregateRoot>> {
    -id: Long
    -areaCode: AirControlAreaCode
    -subArea: WeatherSubArea
    -period: ObservationPeriod
    -wind: WindCondition
    +toDTO(): WeatherDataDTO
  }
  class AirControlArea <<AggregateRoot>> {
    -areaCode: AirControlAreaCode
    -name: String
  }
}

package "Repository" {
  interface FlightPlanRepository {
    +findByPilot(email: String): Iterable<FlightPlan>
    +ofIdentity(id: Long): Optional<FlightPlan>
    +save(plan: FlightPlan): FlightPlan
  }
  interface WeatherDataRepository {
    +findByArea(areaCode: AirControlAreaCode): Iterable<WeatherData>
  }
  interface AirControlAreaRepository {
    +findAll(): Iterable<AirControlArea>
  }
}

InsertWeatherDataUI ..> InsertWeatherDataController
InsertWeatherDataController ..> FlightPlanRepository
InsertWeatherDataController ..> WeatherDataRepository
InsertWeatherDataController ..> AirControlAreaRepository
InsertWeatherDataController ..> FlightPlanDTO
InsertWeatherDataController ..> WeatherDataDTO
InsertWeatherDataController ..> AirControlAreaDTO
FlightPlan *-- FlightPlanStatus
FlightPlanRepository ..> FlightPlan
WeatherDataRepository ..> WeatherData
AirControlAreaRepository ..> AirControlArea

@enduml
