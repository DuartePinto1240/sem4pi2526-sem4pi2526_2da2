@startuml
actor Pilot
participant TestFlightPlanUI as UI <<boundary>>
participant TestFlightPlanController as CTRL <<control>>
participant FlightPlanRepository as REPO <<repository>>
participant AircraftRepository as AREPO <<repository>>
participant AircraftModelRepository as MREPO <<repository>>
participant WeatherDataRepository as WREPO <<repository>>
participant FlightPlanImporter as IMPORTER <<service>>
participant "flight_plan_test\n(C program)" as C <<external>>
participant "plan:FlightPlan" as FP <<domain>>

Pilot -> UI : doShow()

UI -> CTRL : listDraftFlightPlans(pilotEmail)
activate CTRL
CTRL -> REPO : findByPilotAndStatus(pilotEmail, DRAFT)
REPO --> CTRL : Iterable<FlightPlan>
CTRL --> UI : List<FlightPlan>
deactivate CTRL

UI --> Pilot : displays DRAFT flight plans (filtered by pilot)
Pilot -> UI : selects flight plan

UI -> CTRL : testFlightPlan(flightPlanId)
activate CTRL

CTRL -> REPO : findByFlightId(flightPlanId)
REPO --> CTRL : Optional<FlightPlan>

note right of CTRL
  Validates: plan exists,
  status == DRAFT,
  dslContent not blank
end note

CTRL -> IMPORTER : importFromString(dslContent)
activate IMPORTER
note right of IMPORTER
  Lexical + Syntactic
  + Semantic validation
  (phase order, ≥3 segments per leg,
  altitude range, fuel > 0, etc.)
end note
IMPORTER --> CTRL : FlightPlanImportResult
deactivate IMPORTER

alt DSL validation failed
  CTRL --> UI : FlightPlanTestResult.fail(errors)
  UI --> Pilot : shows FAIL + DSL errors
else DSL valid — resolve aircraft + weather

  CTRL -> AREPO : ofIdentity(plan.aircraftRegistration)
  AREPO --> CTRL : Optional<Aircraft>
  CTRL -> MREPO : ofIdentity(aircraft.aircraftModelId)
  MREPO --> CTRL : Optional<AircraftModel>
  note right of CTRL
    Returns FlightCharacteristics:
    maxFuelCapacity, serviceCeiling(m), cruiseSpeed.
    serviceCeiling converted to feet.
    Falls back to defaults if no aircraft assigned:
    999999 kg / 45000 ft / 800 km/h.
  end note

  CTRL -> WREPO : ofIdentity(plan.weatherDataId)
  WREPO --> CTRL : Optional<WeatherData>
  note right of CTRL
    For each segment whose midpoint falls within
    the weather sub-area and altitude range overlaps:
    seg.windAngle ← weather.wind.direction
    seg.windSpeed ← weather.wind.speed
  end note

  CTRL -> C : ProcessBuilder args:\nnum_legs maxFuelCapacity serviceCeiling(ft) cruiseSpeedKmh\n  leg_fuel leg_num_segs\n    fromLat fromLon toLat toLon\n    minAlt maxAlt windAngle windSpeed phase\n    ... (per segment)\n  ... (per leg)
  activate C
  note right of C
    Checks per leg:
      total fuel <= maxFuelCapacity
      leg fuel >= Haversine*2.5 + 200 kg reserve
    Checks per segment:
      altitudeMax <= serviceCeiling
    Outputs:
      PASS <totalDistKm> <totalFuelKg> <burnKg>
      or FAIL + error lines
  end note
  C --> CTRL : stdout: PASS ... or FAIL\nexit code: 0 or 1
  deactivate C

  alt C checker PASS
    CTRL -> FP : markAsTested("PASS — dist/fuel/burn/duration")
    activate FP
    note right of FP
      Precondition: status == DRAFT
      status ← TESTED
      testResult ← summary
    end note
    FP --> CTRL : ok
    deactivate FP
    CTRL -> REPO : save(flightPlan)
    CTRL --> UI : FlightPlanTestResult.pass(dist, fuel, burn, cruiseSpeedKmh)
    UI --> Pilot : shows PASS box\n(distance, duration, fuel burn, remaining fuel)\nplan marked as TESTED
  else C checker FAIL
    CTRL --> UI : FlightPlanTestResult.fail(errors)
    UI --> Pilot : shows FAIL box + feasibility errors\nplan stays DRAFT
  end
end

deactivate CTRL
@enduml
