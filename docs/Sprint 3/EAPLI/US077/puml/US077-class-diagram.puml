@startuml

package "Presentation" {
  class RemovePilotUI {
    +doShow(): boolean
    +headline(): String
    -getActivePilots(): List<PilotDTO>
    -removePilot(pilot: PilotDTO): void
  }
}

package "Application" {
  class RemovePilotController {
    -atcRepo: AirTransportCompanyRepository
    -pilotRepo: PilotRepository
    -flightPlanRepo: FlightPlanRepository
    +getActivePilots(collaboratorEmail: String): List<PilotDTO>
    +removePilot(pilotEmail: String): void
    -findByCollaborator(email: String): AirTransportCompany
    -listActivePilots(company: AirTransportCompany): List<Pilot>
    -findPilotByEmail(email: String): Pilot
    -existsAssignedFlightPlanForPilot(email: String): boolean
    -deactivatePilot(pilot: Pilot): void
  }
  class PilotDTO {
    +id: Long
    +name: String
    +email: String
    +phoneNumber: String
    +active: boolean
    +companyIata: String
    +from(p: Pilot): PilotDTO
  }
}

package "Domain" {
  class AirTransportCompany <<AggregateRoot>> {
    -companyCode: CompanyCode
    -name: String
  }
  class Pilot <<AggregateRoot>> {
    -name: String
    -email: String
    -phoneNumber: String
    -active: boolean
    -certifiedModels: List<AircraftModel>
    +deactivate(): void
    +isActive(): boolean
  }
  class CompanyCode <<ValueObject>> {
    -iata: String
    -icao: String
  }
}

package "Repository" {
  interface AirTransportCompanyRepository {
    +findByCollaborator(email: String): Optional<AirTransportCompany>
  }
  interface PilotRepository {
    +findActiveByCompany(company: AirTransportCompany): Iterable<Pilot>
    +findByEmail(email: String): Optional<Pilot>
    +save(pilot: Pilot): Pilot
  }
  interface FlightPlanRepository {
    +existsAssignedFlightPlansForPilot(pilotEmail: String): boolean
  }
}

RemovePilotUI ..> RemovePilotController
RemovePilotController ..> AirTransportCompanyRepository
RemovePilotController ..> PilotRepository
RemovePilotController ..> FlightPlanRepository
RemovePilotController ..> PilotDTO
AirTransportCompany *-- CompanyCode
AirTransportCompanyRepository ..> AirTransportCompany
PilotRepository ..> Pilot

@enduml
