@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class ListUsersUI <<boundary>> {
    +doShow(): boolean
  }
}

package "Application" {
  class ListUsersController <<control>> {
    +allUsers(): Iterable<UserDTO>
  }
}

package "DTO" {
  class UserDTO <<dto>> {
    -email: String
    -name: String
    -role: String
    -phoneNumber: String
    -staffNumber: String
    -active: boolean
    -securityClearanceExpiry: LocalDate
    -nextSkillsAssessmentDate: LocalDate
    +getName(): String
    +getEmail(): String
    +getRole(): String
    +isActive(): boolean
    +getSecurityClearanceExpiry(): LocalDate
    +getNextSkillsAssessmentDate(): LocalDate
    +toString(): String
  }
}

package "Domain" {
  class User <<aggregate root>> {
    -name: String
    -email: EmailAddress
    -role: String
    -phoneNumber: String
    -active: boolean
    -securityClearanceExpiry: LocalDate
    -nextSkillsAssessmentDate: LocalDate
  }
  class BaseRoles <<utility>> {
    {static} +BACKOFFICE_OPERATOR: Role
  }
}

package "Infrastructure.Persistence" {
  class PersistenceContext <<singleton>> {
    +userRepository(): UserRepository
  }
  interface UserRepository <<repository>> {
    +findByRole(role): Iterable<User>
  }
}

ListUsersUI ..> ListUsersController
ListUsersUI ..> UserDTO : displays
ListUsersController ..> PersistenceContext
ListUsersController ..> BaseRoles : BACKOFFICE_OPERATOR filter
ListUsersController ..> User : reads
ListUsersController ..> UserDTO : creates (converts User -> UserDTO)
PersistenceContext ..> UserRepository
UserRepository ..> User

note right of ListUsersController
  Only BackOffice Operators are listed.
  Uses findByRole("BACKOFFICE_OPERATOR")
  instead of findAll().
  DTO pattern:
  Converts each domain User to UserDTO
  before returning — UI never accesses
  domain objects directly.
end note

note right of UserDTO
  No domain logic.
  No JPA annotations.
  No framework dependencies.
  Pure data carrier for the UI layer.
end note
@enduml
