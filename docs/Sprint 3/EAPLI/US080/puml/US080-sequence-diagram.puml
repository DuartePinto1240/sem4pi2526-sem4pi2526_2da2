@startuml
actor Pilot
participant CreateFlightPlanUI as UI <<boundary>>
participant CreateFlightPlanController as CTRL <<control>>
participant FlightPlanDslGenerator as DSL <<service>>
participant "plan:FlightPlan" as PLAN <<domain>>
participant FlightPlanRepository as REPO <<repository>>
participant AirportRepository as AREPO <<repository>>
participant AirControlAreaRepository as ACREPO <<repository>>

Pilot -> UI : doShow()

UI -> CTRL : currentPilot()
CTRL --> UI : pilot (from session email)

UI -> CTRL : activeRoutesForPilot(pilot)
CTRL --> UI : routes filtered by pilot's company

UI --> Pilot : shows route list (company-filtered)
Pilot -> UI : selects route

UI -> CTRL : aircraftForRoute(route)
CTRL --> UI : aircraft list (same company)
UI --> Pilot : shows aircraft list
Pilot -> UI : selects aircraft

UI --> Pilot : shows flightId, departure date/time prompt
Pilot -> UI : enters flightId, departure date/time

loop for each leg
    note over UI
      Departure airport and date/time pre-filled
      (route.originIata for leg 1, previous arrival for subsequent legs)
    end note

    UI --> Pilot : arrival airport prompt (Enter = route destination)
    Pilot -> UI : enters arrival airport, arrival time, fuel (kg)

    UI -> CTRL : boundaryForAirport(leg.departureAirport)
    activate CTRL
    CTRL -> AREPO : findByIataCode(iataCode)
    AREPO --> CTRL : Optional<Airport>
    alt airport found
        CTRL -> ACREPO : ofIdentity(airport.airControlAreaCode)
        ACREPO --> CTRL : Optional<AirControlArea>
    end
    CTRL --> UI : Optional<GeographicBoundary>
    deactivate CTRL

    note over UI
      If boundary found: displays lat/lon range hint to pilot
      before each segment prompt.
      Minimum 3 segments required: climb, cruise, descent.
      For each segment: phase (climb/cruise/descent),
        from/to coords, altitude min/max (ft), width (m), wind.
    end note

    Pilot -> UI : enters segments for this leg

    UI -> CTRL : validateLegCoordinates(leg)
    activate CTRL
    loop for each segment in leg
        CTRL -> CTRL : check from/to coords within boundary
        alt coord outside boundary
            CTRL --> UI : throws IllegalArgumentException
            note over UI: Leg discarded — pilot re-enters
        end
    end
    CTRL --> UI : OK
    deactivate CTRL

    note over UI
      Leg added. If arrival == destination: done.
      Otherwise: prompt for next leg departure date/time.
    end note
end

UI -> CTRL : createFlightPlan(flightId, route, aircraft, pilot, departureDateTime, legs)
activate CTRL

CTRL -> CTRL : check existsByFlightId → reject if duplicate
CTRL -> CTRL : validate route is active
CTRL -> CTRL : validate aircraft.companyIata == route.companyIata
CTRL -> CTRL : validate pilot.companyIata == route.companyIata
CTRL -> CTRL : validate departureDateTime is in the future
CTRL -> CTRL : validateSegmentCoordinates(legs) [double-check all legs]

CTRL -> DSL : generate(flightId, flightType, legs)
DSL --> CTRL : dslContent (phase + altitude_range + from/to per segment)

CTRL -> PLAN : new FlightPlan(flightId, flightType, legs,\n  routeDesignator, aircraftReg, pilotId)
activate PLAN
PLAN -> PLAN : status = DRAFT
PLAN -> PLAN : importedAt = now()
PLAN --> CTRL : plan
deactivate PLAN

CTRL -> PLAN : setDslContent(dsl)
CTRL -> PLAN : setPilotEmail(pilot.email)
CTRL -> REPO : save(plan)
CTRL --> UI : plan
deactivate CTRL

UI --> Pilot : displays confirmation\n(flightId, type, route, aircraft,\n legs with segment count, status=DRAFT, DSL stored)
@enduml
