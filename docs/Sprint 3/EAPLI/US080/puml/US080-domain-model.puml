@startuml
title Domain Model — US080 (Create Flight Plan)
skinparam linetype ortho

class FlightPlan {
  + flightId : String
  + flightType : String
  + status : FlightPlanStatus
  + importedAt : LocalDateTime
}

class FlightLeg {
  + departureAirport : String
  + departureDate : String
  + departureTime : String
  + arrivalAirport : String
  + arrivalTime : String
  + fuelQuantity : double
  + fuelUnit : String
}

enum FlightPlanStatus {
  DRAFT
  TESTED
  APPROVED
}

FlightPlan "1" *-- "1..*" FlightLeg
FlightPlan --> FlightPlanStatus

@enduml
