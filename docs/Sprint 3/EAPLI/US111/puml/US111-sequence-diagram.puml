@startuml US111-sequence-diagram
actor "Flight Control\nOperator" as OP
participant GenerateSimulationReportUI as UI <<boundary>>
participant GenerateSimulationReportController as CTRL <<control>>
participant "report:SimulationReport" as SR <<aggregate root>>
participant SimulationReportRepository as REPO <<repository>>

OP -> UI : doShow()

UI -> CTRL : availableReportFiles()
activate CTRL
CTRL -> CTRL : scan directory for\nsimulation_report_*.txt files
CTRL --> UI : List<String> filenames
deactivate CTRL

UI --> OP : numbered file list

OP -> UI : selects file number

UI -> CTRL : generateReport(filename)
activate CTRL

CTRL -> CTRL : open file\n(reportsDir + filename)

alt file not found
    CTRL --> UI : throw IllegalArgumentException\n"Report file not found"
    UI --> OP : show error message
end

CTRL -> CTRL : parse total flights
CTRL -> CTRL : parse flight statuses\n(OK / VIOLATED / ABORTED)
CTRL -> CTRL : parse violation events\n(timestamp, positions, velocities)
CTRL -> CTRL : parse overall result\n(PASS / FAIL)

CTRL -> SR : new SimulationReport(\n  id, generatedAt,\n  totalFlights, statuses,\n  violations, result)
activate SR
SR -> SR : validate totalFlights > 0
SR -> SR : validate statuses not empty
SR --> CTRL : report
deactivate SR

CTRL -> REPO : save(report)
activate REPO
REPO --> CTRL : savedReport
deactivate REPO

CTRL --> UI : savedReport
deactivate CTRL

UI --> OP : display report summary

note right of UI
  Shows:
  - Generated at
  - Total flights
  - Per-flight status (OK/VIOLATED/ABORTED)
  - Violation events (timestamp, positions)
  - Overall result: PASS / FAIL
end note

alt parse error — invalid format
    CTRL --> UI : throw IllegalArgumentException\n"Could not read report file"
    UI --> OP : show error message
end

@enduml