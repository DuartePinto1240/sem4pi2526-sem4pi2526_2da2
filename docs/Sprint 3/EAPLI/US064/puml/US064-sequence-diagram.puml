@startuml SD_US064
title US064 – Disable a Customer's Collaborator\n(Sequence Diagram)

skinparam sequence {
    ActorBorderColor #534AB7
    ActorBackgroundColor #D0C8F8
    ParticipantBorderColor #0F6E56
    ParticipantBackgroundColor #C2EAD8
    LifeLineBorderColor #854F0B
    NoteBackgroundColor #FAE8C0
    NoteBorderColor #854F0B
    ArrowColor #333333
}

actor "Backoffice Operator" as BO
participant "DisableCollaboratorUI" as UI
participant "DisableCollaboratorController" as CTRL
participant "CustomerRepository" as CREPO
participant "UserRepository" as UREPO
participant "AirTransportCompany\n/ AirControlArea" as CUSTOMER
participant "ATCC\n/ FlightControlOperator" as COLLAB
participant "User" as USER

BO -> UI : requests to disable a collaborator
activate UI

UI -> CTRL : getAvailableCustomers()
activate CTRL
CTRL -> CREPO : findAllAirTransportCompanies()
CREPO --> CTRL : List<AirTransportCompany>
CTRL -> CREPO : findAllAirControlAreas()
CREPO --> CTRL : List<AirControlArea>
CTRL --> UI : List<CustomerDTO>
deactivate CTRL

UI --> BO : displays customer list
BO -> UI : selects customer

UI -> CTRL : listCollaborators(customerId, customerType)
activate CTRL
CTRL -> CREPO : findById(customerId, customerType)
CREPO --> CTRL : customer
CTRL -> CUSTOMER : listActiveCollaborators()
activate CUSTOMER
CUSTOMER --> CTRL : collaborators
deactivate CUSTOMER
CTRL --> UI : List<CollaboratorDTO>
deactivate CTRL

UI --> BO : displays active collaborator list

BO -> UI : selects collaborator
UI --> BO : asks for confirmation
BO -> UI : confirms

UI -> CTRL : disableCollaborator(customerId, customerType, email)
activate CTRL

CTRL -> CREPO : findById(customerId, customerType)
CREPO --> CTRL : customer

CTRL -> CUSTOMER : disableCollaborator(email)
activate CUSTOMER

CUSTOMER -> COLLAB : disable()
activate COLLAB

COLLAB --> CUSTOMER : ok
deactivate COLLAB
CUSTOMER --> CTRL : ok
deactivate CUSTOMER

CTRL -> CREPO : save(customerAggregate)


CTRL -> UREPO : findByEmail(email)
UREPO --> CTRL : user

CTRL -> USER : disable()
activate USER
USER --> CTRL : ok
deactivate USER

CTRL -> UREPO : save(user)

CTRL --> UI : success
UI --> BO : "Collaborator disabled successfully"

deactivate CTRL
deactivate UI

@enduml
