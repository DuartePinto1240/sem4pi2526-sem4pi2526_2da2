@startuml
left to right direction

actor "Air Transport Company\nCollaborator (ATCC)" as ATCC

rectangle "Remote Access Module" {
  usecase "Remote Access via\nTCP Client" as UC_Access
  usecase "Authenticate" as UC_Auth
  usecase "Add Aircraft to Fleet\n(US070)" as UC_070
  usecase "Decommission Aircraft\n(US071)" as UC_071
  usecase "List Company Fleet\n(US072)" as UC_072
  usecase "Create Flight Route\n(US073)" as UC_073
  usecase "Delete Flight Route\n(US074)" as UC_074
  usecase "Add Pilot\n(US075)" as UC_075
  usecase "List Pilot Roster\n(US076)" as UC_076
  usecase "Remove Pilot\n(US077)" as UC_077
}

ATCC --> UC_Access

UC_Access ..> UC_Auth : <<include>>
UC_Access ..> UC_070  : <<extend>>
UC_Access ..> UC_071  : <<extend>>
UC_Access ..> UC_072  : <<extend>>
UC_Access ..> UC_073  : <<extend>>
UC_Access ..> UC_074  : <<extend>>
UC_Access ..> UC_075  : <<extend>>
UC_Access ..> UC_076  : <<extend>>
UC_Access ..> UC_077  : <<extend>>

@enduml
