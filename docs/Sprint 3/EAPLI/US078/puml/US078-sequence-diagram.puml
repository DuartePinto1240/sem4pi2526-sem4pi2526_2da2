@startuml SD_US078
title US078 – Air Transport Company Collaborator Remote Access\n(Sequence Diagram)

skinparam sequence {
    ActorBorderColor #534AB7
    ActorBackgroundColor #D0C8F8
    ParticipantBorderColor #0F6E56
    ParticipantBackgroundColor #C2EAD8
    LifeLineBorderColor #854F0B
    NoteBackgroundColor #FAE8C0
    NoteBorderColor #854F0B
    ArrowColor #333333
}

actor "ATCC" as ATCC
participant "AirTransportCompanyApp\n(TCP Client)" as CLIENT
participant "AirTransportCompanyServer\n(TCP Server)" as SERVER
participant "TCPRequestHandler" as HANDLER
participant "AuthorizationService" as AUTHZ
participant "Controller\n(US070–US077)" as CTRL

ATCC -> CLIENT : launches client application
activate CLIENT

CLIENT -> SERVER : TCP connect()
activate SERVER
SERVER -> HANDLER : new TCPRequestHandler(socket)
activate HANDLER
SERVER --> CLIENT : connection accepted
deactivate SERVER

CLIENT -> HANDLER : authenticate(email, password)
HANDLER -> AUTHZ : authenticate(email, password)
activate AUTHZ
AUTHZ --> HANDLER : success / failure
deactivate AUTHZ

alt authentication failed
    HANDLER --> CLIENT : Response(UNAUTHORIZED)
    CLIENT --> ATCC : displays error, closes connection
else authentication successful
    HANDLER --> CLIENT : Response(OK)
    CLIENT --> ATCC : displays main menu

    ATCC -> CLIENT : selects operation (e.g. list fleet)

    CLIENT -> HANDLER : Request(operation, payload, credentials)
    HANDLER -> AUTHZ : ensureAuthenticatedUserHasAnyOf(ATCC)
    activate AUTHZ
    AUTHZ --> HANDLER : authorized
    deactivate AUTHZ

    HANDLER -> CTRL : execute operation
    activate CTRL
    CTRL --> HANDLER : result
    deactivate CTRL

    HANDLER --> CLIENT : Response(OK, result)
    CLIENT --> ATCC : displays result
end

deactivate HANDLER
deactivate CLIENT

@enduml
