@startuml US071-sequence-diagram
actor "Air Transport Company\nCollaborator" as ATCC
participant DecommissionAircraftUI as UI <<boundary>>
participant DecommissionAircraftController as CTRL <<control>>
participant AircraftRepository as REPO <<repository>>
participant "aircraft:Aircraft" as AIRCRAFT <<entity>>

ATCC -> UI : doShow()

UI -> ATCC : prompts for company IATA code
ATCC -> UI : enters companyIata

UI -> CTRL : activeAircraftOfCompany(companyIata)
activate CTRL
  CTRL -> REPO : findByCompanyIata(companyIata)
  activate REPO
  REPO --> CTRL : Iterable<Aircraft>
  deactivate REPO

  loop for each aircraft
    CTRL -> AIRCRAFT : operationalStatus().isActive()
    AIRCRAFT --> CTRL : boolean
  end

  CTRL --> UI : Iterable<Aircraft> (active only)
deactivate CTRL

alt no active aircraft found
  UI --> ATCC : "No active aircraft found for company"
else active aircraft exist
  UI --> ATCC : displays numbered list of active aircraft

  ATCC -> UI : selects aircraft by number
  ATCC -> UI : confirms with "yes"

  UI -> CTRL : decommissionAircraft(registration, companyIata)
  activate CTRL

    CTRL -> REPO : ofIdentity(registration)
    activate REPO
    REPO --> CTRL : Optional<Aircraft>
    deactivate REPO

    alt aircraft not found
      CTRL --> UI : throws IllegalArgumentException
      UI --> ATCC : "Aircraft with registration '...' not found."
    else aircraft found

      CTRL -> AIRCRAFT : companyIata()
      AIRCRAFT --> CTRL : aircraftCompanyIata

      alt aircraft belongs to a different company
        CTRL --> UI : throws IllegalArgumentException
        UI --> ATCC : "Aircraft '...' does not belong to company '...'."
      else aircraft belongs to collaborator's company

        CTRL -> AIRCRAFT : decommission()
        activate AIRCRAFT
          AIRCRAFT -> AIRCRAFT : Preconditions.ensure(isActive(), ...)
          note right: throws IllegalArgumentException\nif already DECOMMISSIONED
          AIRCRAFT -> AIRCRAFT : operationalStatus = OperationalStatus.decommissioned()
          AIRCRAFT --> CTRL : ok
        deactivate AIRCRAFT

        CTRL -> REPO : save(aircraft)
        activate REPO
        REPO --> CTRL : aircraft (persisted)
        deactivate REPO

        CTRL --> UI : Aircraft (decommissioned)
        UI --> ATCC : "Aircraft '...' has been decommissioned successfully.\n   Status: DECOMMISSIONED"
      end
    end
  deactivate CTRL
end

@enduml
