@startuml US071-class-diagram
skinparam classAttributeIconSize 0

package "UI Layer" {
  class DecommissionAircraftUI <<boundary>> {
    + doShow() : boolean
    + headline() : String
  }
}

package "Application Layer" {
  class DecommissionAircraftController <<control>> {
    - aircraftRepo : AircraftRepository
    + DecommissionAircraftController()
    + DecommissionAircraftController(aircraftRepo : AircraftRepository)
    + activeAircraftOfCompany(companyIata : String) : Iterable<Aircraft>
    + decommissionAircraft(registration : String, companyIata : String) : Aircraft
  }
}

package "Domain Layer" {
  class Aircraft <<entity>> <<AggregateRoot>> {
    - registration : String
    - countryOfRegistration : String
    - companyIata : String
    - aircraftModelId : Long
    - cabinConfiguration : CabinConfiguration
    - operationalStatus : OperationalStatus
    - registrationDate : LocalDate
    + Aircraft(registration, countryOfRegistration,\n companyIata, model, cabinConfiguration)
    + identity() : String
    + registration() : String
    + companyIata() : String
    + operationalStatus() : OperationalStatus
    + decommission() : void
    + ageInYears() : int
  }

  class OperationalStatus <<ValueObject>> <<Embeddable>> {
    - status : Status
    + {static} active() : OperationalStatus
    + {static} decommissioned() : OperationalStatus
    + isActive() : boolean
    + isDecommissioned() : boolean
    + status() : Status
  }

  enum Status {
    ACTIVE
    DECOMMISSIONED
  }

  interface AircraftRepository <<Repository>> {
    + ofIdentity(registration : String) : Optional<Aircraft>
    + findByCompanyIata(companyIata : String) : Iterable<Aircraft>
    + save(aircraft : Aircraft) : Aircraft
    + existsByRegistration(registration : String) : boolean
    + containsOfIdentity(registration : String) : boolean
    + findAll() : Iterable<Aircraft>
    + count() : long
  }
}

package "Infrastructure Layer" {
  class InMemoryAircraftRepository <<infrastructure>> {
    - store : List<Aircraft>
    + ofIdentity(registration : String) : Optional<Aircraft>
    + findByCompanyIata(companyIata : String) : Iterable<Aircraft>
    + save(aircraft : Aircraft) : Aircraft
    + existsByRegistration(registration : String) : boolean
    + containsOfIdentity(registration : String) : boolean
    + findAll() : Iterable<Aircraft>
    + count() : long
  }
}

DecommissionAircraftUI --> DecommissionAircraftController
DecommissionAircraftController --> AircraftRepository

Aircraft *-- OperationalStatus
OperationalStatus *-- Status

InMemoryAircraftRepository ..|> AircraftRepository

@enduml
