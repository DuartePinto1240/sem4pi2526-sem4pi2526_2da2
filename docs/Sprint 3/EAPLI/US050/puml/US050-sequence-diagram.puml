@startuml US050-sequence-diagram
actor "Backoffice Operator" as BO
participant RegisterAirControlAreaUI as UI <<boundary>>
participant RegisterAirControlAreaController as CTRL <<control>>
participant AuthorizationService as AUTHZ <<service>>
participant AirControlAreaRepository as REPO <<repository>>
participant AirControlArea as AREA <<entity>>

BO -> UI : doShow()

UI -> CTRL : allAreas()
CTRL -> REPO : findAll()
REPO --> CTRL : Iterable<AirControlArea>
CTRL --> UI : Iterable<AirControlArea>
UI --> BO : displays existing areas

BO -> UI : provides code, name,\nminLat, maxLat, minLon, maxLon

UI -> CTRL : registerAirControlArea(\n  code, name,\n  minLat, maxLat, minLon, maxLon)

CTRL -> AUTHZ : ensureAuthenticatedUserHasAnyOf(BACKOFFICE_OPERATOR)
activate AUTHZ
AUTHZ --> CTRL : ok (or throws UnauthorizedException)
deactivate AUTHZ

CTRL -> REPO : containsOfIdentity(AirControlAreaCode(code))
activate REPO
REPO --> CTRL : boolean
deactivate REPO

alt area code already exists
  CTRL --> UI : throws IllegalArgumentException
  UI --> BO : "Area code already exists"
else area code is unique

  CTRL -> REPO : existsByName(name)
  activate REPO
  REPO --> CTRL : boolean
  deactivate REPO

  alt area name already exists
    CTRL --> UI : throws IllegalArgumentException
    UI --> BO : "Area name already exists"
  else area name is unique

    CTRL -> REPO : existsOverlappingBoundary(boundary)
    activate REPO
    REPO --> CTRL : boolean
    deactivate REPO

    alt boundary overlaps existing area
      CTRL --> UI : throws IllegalArgumentException
      UI --> BO : "Boundary overlaps existing area"
    else boundary is valid

      CTRL -> AREA ** : new AirControlArea(code, name, boundary)

      CTRL -> REPO : save(area)
      activate REPO
      REPO --> CTRL : area (persisted)
      deactivate REPO

      CTRL --> UI : AirControlArea
      UI --> BO : "Air control area registered successfully"
    end
  end
end

@enduml
