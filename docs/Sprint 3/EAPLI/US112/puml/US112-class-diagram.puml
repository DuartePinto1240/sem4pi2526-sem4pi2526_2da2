@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class MonthlyReportUI <<boundary>> {
    +doShow(): boolean
  }
}

package "Application" {
  class MonthlyReportController <<control>> {
    -REPORTS_OUT_DIR: String
    -repo: SimulationReportRepository
    +MonthlyReportController()
    +generateMonthlyReport(year: int, month: int): String
    +previewMonthlyReport(year: int, month: int): String
    -reportsForMonth(year: int, month: int): List<SimulationReport>
    -validateMonth(month: int): void
  }
}

package "Report" {
  abstract class AbstractReport <<template>> {
    +generate(): String
    +generateToFile(filePath: String): void
    +generateHeader(): String
    {abstract} #generateBody(): String
    +generateFooter(): String
    {abstract} #reportTitle(): String
    {abstract} #reportPeriod(): String
  }

  class MonthlyStatisticsReport <<concrete>> {
    -year: int
    -month: int
    -data: List<SimulationReport>
    +MonthlyStatisticsReport(year: int, month: int, data: List<SimulationReport>)
    #generateBody(): String
    #reportTitle(): String
    #reportPeriod(): String
  }
}

package "Domain" {
  class SimulationReport <<entity>> {
    +identity(): SimulationReportId
    +generatedAt(): LocalDateTime
    +totalFlights(): int
    +result(): OverallValidationResult
    +flightStatuses(): List<FlightExecutionStatus>
    +violationEvents(): List<SafetyViolationEvent>
  }

  interface SimulationReportRepository <<repository>> {
    +findAll(): Iterable<SimulationReport>
    +save(report: SimulationReport): SimulationReport
  }
}

MonthlyReportUI ..> MonthlyReportController : uses
MonthlyReportController ..> MonthlyStatisticsReport : creates
MonthlyReportController --> SimulationReportRepository : queries
MonthlyStatisticsReport --|> AbstractReport
MonthlyStatisticsReport ..> SimulationReport : reads

note right of AbstractReport
  Template Method Pattern.
  generate() = header + body + footer.
  Only generateBody() varies
  per report type.
end note

note bottom of MonthlyStatisticsReport
  Future report types follow the same pattern:
  ComplianceReport extends AbstractReport
  IncidentReport   extends AbstractReport
  -> only override generateBody()
end note
@enduml
