@startuml
actor "Flight Control Operator" as FCO
participant MonthlyReportUI as UI <<boundary>>
participant MonthlyReportController as CTRL <<control>>
participant MonthlyStatisticsReport as REPORT <<concrete>>
participant AbstractReport as BASE <<template>>

FCO -> UI : doShow()
UI --> FCO : asks for year and month

FCO -> UI : enters 2026 / 05
UI -> CTRL : generateMonthlyReport(2026, 5)
activate CTRL

CTRL -> CTRL : load simulation results for May 2026
CTRL -> REPORT : new MonthlyStatisticsReport(2026, 5, data)
activate REPORT

CTRL -> REPORT : generate()
REPORT -> BASE : generateHeader()
BASE --> REPORT : header string (AISafe branding)
REPORT -> REPORT : generateBody()
note right: specific to monthly stats\n(totals, pass/fail, per-flight)
REPORT -> BASE : generateFooter()
BASE --> REPORT : footer string
REPORT --> CTRL : full report content
deactivate REPORT

CTRL -> CTRL : write to file\nreport_monthly_2026_05_<ts>.txt
CTRL --> UI : filename
deactivate CTRL

UI --> FCO : "Report saved to report_monthly_2026_05_<ts>.txt"
@enduml
