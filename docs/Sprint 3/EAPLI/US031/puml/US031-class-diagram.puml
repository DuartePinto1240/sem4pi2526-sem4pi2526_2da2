@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class RegisterUserUI <<boundary>> {
    +doShow(): boolean
    -readName(): String
    -readEmail(): String
    -readPhone(): String
    -readStaffNumber(): String
    -readPassword(): String
    -readClearanceDate(): LocalDate
  }
}

package "Application" {
  class RegisterUserController <<control>> {
    -userSvc: UserManagementService
    -repo: UserRepository
    +registerBackOfficeOperator(email, name, phone, password, staff, clearance): User
    +registerAdmin(email, name, phone, password, staff, clearance): User
  }
}

package "Infrastructure.Authz" {
  class AuthzRegistry <<registry>> {
    {static} +userService(): UserManagementService
  }
  class UserManagementService <<service>> {
    +registerNewUser(username, password, firstName, lastName, email, roles): SystemUser
  }
  class SystemUser <<aggregate root>> {
    -username: Username
    -password: Password
    -roles: RoleSet
    -active: boolean
  }
}

package "Domain" {
  class User <<aggregate root>> {
    -email: EmailAddress
    -name: String
    -phoneNumber: String
    -staffNumber: String
    -active: boolean
    -role: String
    -securityClearanceExpiry: LocalDate
    -nextSkillsAssessmentDate: LocalDate
    +markAsAdmin()
    +isActive(): boolean
    +getRole(): String
    +updateSecurityClearance(LocalDate)
    +updateSkillsAssessment(LocalDate)
  }
  class UserExceptionBuilder <<builder>> {
    +{static} builder(): UserExceptionBuilder
    +{static} of(email, name, phone, staff, clearance): UserExceptionBuilder
    +checkNotNull(value, fieldName): UserExceptionBuilder
    +checkNotBlank(value, fieldName): UserExceptionBuilder
    +checkPhone(phoneNumber): UserExceptionBuilder
    +checkFutureDate(date, fieldName): UserExceptionBuilder
    +checkRole(roleName): UserExceptionBuilder
    +validate(): void
  }
  class EmailAddress <<value object>> {
    -address: String
    +valueOf(String): EmailAddress
  }
  class ValidEmailDomains <<utility>> {
    +register(String)
    +isValid(String): boolean
    +getAll(): Set<String>
  }
  class BaseRoles <<utility>> {
    {static} +ADMIN: Role
    {static} +BACKOFFICE_OPERATOR: Role
  }
}

package "Infrastructure.Persistence" {
  class PersistenceContext <<singleton>> {
    +getInstance(): PersistenceContext
    +userRepository(): UserRepository
  }
  interface UserRepository <<repository>> {
    +save(user): User
    +ofIdentity(EmailAddress): Optional<User>
    +findAll(): Iterable<User>
  }
}

RegisterUserUI ..> RegisterUserController
RegisterUserUI ..> ValidEmailDomains : checks domain
RegisterUserController ..> AuthzRegistry : userService()
RegisterUserController ..> UserManagementService : registerNewUser()
RegisterUserController ..> ValidEmailDomains : validates
RegisterUserController ..> PersistenceContext
RegisterUserController ..> User : creates
RegisterUserController ..> BaseRoles : assigns BACKOFFICE_OPERATOR
UserManagementService ..> SystemUser : creates
PersistenceContext ..> UserRepository
User *-- EmailAddress
User ..> UserExceptionBuilder : delegates validation

note right of RegisterUserController
  Admin only creates BackOffice Operators.
  (Other roles created by BackOffice Operator
  when adding collaborators/customers.)

  Order of operations:
  1. Build & validate domain User FIRST
     via UserExceptionBuilder.validate()
     -> IllegalArgumentException on failure,
        NO SystemUser created (no orphan)
  2. Register SystemUser in framework
     (credentials + BACKOFFICE_OPERATOR role)
  3. Persist domain User
end note

note right of User
  Does NOT hold password or admin flag.
  Authentication delegated to SystemUser.
  role field is display-only string.
  nextSkillsAssessmentDate auto = today+5yr
  All validation delegated to UserExceptionBuilder.
end note

note right of UserExceptionBuilder
  Accumulates violations in a list.
  validate() throws IllegalArgumentException
  with all messages joined by " | ".
  Keeps User class free of inline guard clauses.
end note
@enduml
