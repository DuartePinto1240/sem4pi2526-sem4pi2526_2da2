@startuml
actor Administrator
participant RegisterUserUI as UI <<boundary>>
participant RegisterUserController as CTRL <<control>>
participant ValidEmailDomains as VED <<utility>>
participant "UserExceptionBuilder" as UEB <<builder>>
participant "domainUser:User" as USER <<domain>>
participant PersistenceContext as PCON <<singleton>>
participant UserRepository as REPO <<repository>>
participant AuthzRegistry as REG <<registry>>
participant UserManagementService as SVC <<service>>

Administrator -> UI : doShow()
UI -> Administrator : requests user data (field by field)

note right of UI
  Role is fixed to BACKOFFICE_OPERATOR — not shown to user.
  Admin can only create BackOffice Operators.
  Each field validated immediately with retry:
  Email: format + domain + uniqueness.
  Phone: 9 digits + uniqueness.
  Staff: uniqueness.
  Clearance: valid future date.
end note

Administrator -> UI : name, email, phone, staffNumber, password, clearanceExpiry
UI -> VED : isValid(email)
VED --> UI : true
UI -> PCON : getInstance().userRepository()
PCON --> UI : repo
UI -> REPO : ofIdentity(email) [uniqueness check]
REPO --> UI : empty

UI -> CTRL : registerBackOfficeOperator(email, name, phone, password, staffNumber, clearanceExpiry)
activate CTRL

CTRL -> REPO : ofIdentity(email) [duplicate check]
REPO --> CTRL : empty

' Step 1 — Build and validate domain User FIRST
CTRL -> USER : new User(email, name, phone, staffNumber, clearanceExpiry)
activate USER
USER -> UEB : of(email, name, phone, staffNumber, clearanceExpiry).validate()
activate UEB
UEB -> UEB : checkNotNull / checkNotBlank / checkPhone / checkFutureDate

alt validation fails
    UEB --> USER : throws IllegalArgumentException
    deactivate UEB
    USER --> CTRL : IllegalArgumentException propagated
    deactivate USER
    CTRL --> UI : IllegalArgumentException
    deactivate CTRL
    UI --> Administrator : "ERROR: <violation messages>"
    note right of CTRL
      NO SystemUser was created.
      No orphan record left in the framework.
    end note
else validation passes
    UEB --> USER : (no exception)
    deactivate UEB
    USER -> USER : role = "BACKOFFICE_OPERATOR"
    USER -> USER : nextSkillsAssessmentDate = today + 5 years
    USER -> USER : active = true
    USER --> CTRL : domainUser (valid)
    deactivate USER

    ' Step 2 — domain User valid: now register SystemUser in framework
    CTRL -> REG : userService()
    REG --> CTRL : svc
    CTRL -> SVC : registerNewUser(email, password, firstName, lastName, email, {BACKOFFICE_OPERATOR})
    note right of CTRL
      name split into firstName/lastName
      (framework requires both non-empty).
      SystemUser only created AFTER domain
      User passes all validation — no orphan risk.
    end note
    SVC --> CTRL : SystemUser (handles auth + role)

    ' Step 3 — persist domain User
    CTRL -> REPO : save(domainUser)
    CTRL --> UI : domainUser
    deactivate CTRL

    UI --> Administrator : displays success\n(name, email, role=BACKOFFICE_OPERATOR, clearance, assessment)
end
@enduml
