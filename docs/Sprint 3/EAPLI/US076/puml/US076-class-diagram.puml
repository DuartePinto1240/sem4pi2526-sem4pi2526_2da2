    }
}

package "application" {
    class ListPilotRosterController {
        - pilotRepository: PilotRepository
        - companyRepository: AirTranspCompRepository
        --
        + activePilotsOfMyCompany(): List<Pilot>
    }
}

package "domain" {
    class Pilot <<AggregateRoot>> {
        - name: String
        - email: String
        - phoneNumber: String
        - certifiedModels: List<AircraftModel>
        - active: boolean
        --
        + isActive(): boolean
        + name(): String
        + email(): String
        + certifiedModels(): List<AircraftModel>
