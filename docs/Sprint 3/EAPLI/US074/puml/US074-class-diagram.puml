@startuml

package "Presentation" {
  class DeleteFlightRouteUI {
    +doShow(): boolean
    +headline(): String
  }
}

package "Application" {
  class DeleteFlightRouteController {
    -companyRepo: AirTransportCompanyRepository
    -flightPlanRepo: FlightPlanRepository
    -routeRepo: FlightRouteRepository
    +getCompanyRoutes(): List<FlightRouteDTO>
    +deleteRoute(routeName: String, date: LocalDate): void
    -findByCollaborator(email: String): AirTransportCompany
    -listActiveRoutes(company: AirTransportCompany): List<FlightRouteDTO>
    -existsPlannedFlightsAfter(route: RouteDesignator, date: LocalDate): boolean
    -findRouteByDesignator(designator: String): FlightRoute
    -deactivateRoute(route: FlightRoute, date: LocalDate): void
  }
  class FlightRouteDTO {
    +designator: String
    +companyIata: String
    +originIata: String
    +destinationIata: String
    +flightType: String
    +active: boolean
    +deactivationDate: LocalDate
    +from(r: FlightRoute): FlightRouteDTO
  }
}

package "Domain" {
  class AirTransportCompany <<AggregateRoot>> {
    -companyCode: CompanyCode
    -name: String
  }
  class FlightRoute <<Entity>> {
    -designator: RouteDesignator
    -companyIata: String
    -originIata: String
    -destinationIata: String
    -active: boolean
    -deactivationDate: LocalDate
    +deactivate(date: LocalDate): void
    +isActive(): boolean
  }
  class RouteDesignator <<ValueObject>> {
    -designator: String
    +value(): String
  }
  class CompanyCode <<ValueObject>> {
    -iata: String
    -icao: String
  }
}

package "Repository" {
  interface AirTransportCompanyRepository {
    +findByCollaborator(email: String): Optional<AirTransportCompany>
    +save(company: AirTransportCompany): AirTransportCompany
  }
  interface FlightRouteRepository {
    +findByCompanyIata(iata: String): Iterable<FlightRoute>
    +ofIdentity(id: RouteDesignator): Optional<FlightRoute>
    +save(route: FlightRoute): FlightRoute
  }
  interface FlightPlanRepository {
    +existsPlannedFlightsAfter(route: RouteDesignator, date: LocalDate): boolean
  }
}

DeleteFlightRouteUI ..> DeleteFlightRouteController
DeleteFlightRouteController ..> AirTransportCompanyRepository
DeleteFlightRouteController ..> FlightRouteRepository
DeleteFlightRouteController ..> FlightPlanRepository
DeleteFlightRouteController ..> FlightRouteDTO
AirTransportCompany *-- CompanyCode
FlightRoute *-- RouteDesignator
AirTransportCompanyRepository ..> AirTransportCompany
FlightRouteRepository ..> FlightRoute
FlightPlanRepository ..> FlightRoute

@enduml
