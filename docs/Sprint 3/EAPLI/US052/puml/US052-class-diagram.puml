@startuml US052-class-diagram
skinparam classAttributeIconSize 0

package "UI Layer" {
  class CreateAirportUI <<boundary>> {
    + doShow() : boolean
    + headline() : String
  }
}

package "Application Layer" {
  class CreateAirportController <<control>> {
    - airportRepo : AirportRepository
    - areaRepo : AirControlAreaRepository
    - countryRepo : CountryRepository
    + CreateAirportController()
    + CreateAirportController(airportRepo, areaRepo, countryRepo)
    + allAreas() : Iterable<AirControlArea>
    + allCountries() : Iterable<Country>
    + createAirport(icao : String, iata : String,\n name : String, town : String,\n countryName : String, latitude : double,\n longitude : double, elevationM : double,\n areaCode : String) : Airport
  }
}

package "Domain Layer" {
  class Airport <<entity>> <<AggregateRoot>> {
    - icaoCode : ICAOCode
    - iataCode : IATACode
    - name : AirportName
    - town : String
    - country : Country
    - coordinates : AirportCoordinates
    - elevation : Elevation
    - airControlAreaCode : AirControlAreaCode
    + Airport(icao, iata, name, town,\n country, coordinates,\n elevation, airControlAreaCode)
    + identity() : ICAOCode
    + iataCode() : IATACode
    + name() : AirportName
    + town() : String
    + country() : Country
    + coordinates() : AirportCoordinates
    + elevation() : Elevation
    + airControlAreaCode() : AirControlAreaCode
    + sameAs(other : Object) : boolean
  }

  class ICAOCode <<ValueObject>> <<EmbeddedId>> {
    - icao : String
    + ICAOCode(icao : String)
    + code() : String
    + compareTo(other : ICAOCode) : int
  }

  class IATACode <<ValueObject>> {
    - iata : String
    + IATACode(iata : String)
    + code() : String
  }

  class AirportName <<ValueObject>> {
    - name : String
    + AirportName(name : String)
    + value() : String
  }

  class AirportCoordinates <<ValueObject>> {
    - latitude : double
    - longitude : double
    + AirportCoordinates(latitude : double, longitude : double)
    + latitude() : double
    + longitude() : double
    + isWithinBoundary(boundary : GeographicBoundary) : boolean
  }

  class Elevation <<ValueObject>> {
    - metres : double
    + Elevation(metres : double)
    + metres() : double
  }

  class Country <<ValueObject>> {
    - name : String
    + Country(name : String)
    + name() : String
  }

  class AirControlAreaCode <<ValueObject>> {
    - code : String
    + AirControlAreaCode(code : String)
    + code() : String
  }

  interface AirportRepository <<Repository>> {
    + save(airport : Airport) : Airport
    + ofIdentity(icao : ICAOCode) : Optional<Airport>
    + containsOfIdentity(icao : ICAOCode) : boolean
    + existsByIATACode(iata : IATACode) : boolean
    + findAll() : Iterable<Airport>
    + delete(airport : Airport) : void
    + deleteOfIdentity(icao : ICAOCode) : void
    + count() : long
  }

  interface AirControlAreaRepository <<Repository>> {
    + ofIdentity(code : AirControlAreaCode) : Optional<AirControlArea>
    + findAll() : Iterable<AirControlArea>
  }

  interface CountryRepository <<Repository>> {
    + findAll() : Iterable<Country>
    + findByName(name : String) : Optional<Country>
  }
}

package "Infrastructure Layer" {
  class JpaAirportRepository <<infrastructure>> {
    + JpaAirportRepository(persistenceUnitName, extendedProperties)
    + JpaAirportRepository(autoTx : TransactionalContext)
    + findAll() : Iterable<Airport>
    + existsByIATACode(iata : IATACode) : boolean
  }

  class InMemoryAirportRepository <<infrastructure>> {
    - airports : List<Airport>
    + findAll() : Iterable<Airport>
    + existsByIATACode(iata : IATACode) : boolean
    + save(airport : Airport) : Airport
    + ofIdentity(icao : ICAOCode) : Optional<Airport>
    + containsOfIdentity(icao : ICAOCode) : boolean
    + delete(airport : Airport) : void
    + deleteOfIdentity(icao : ICAOCode) : void
    + count() : long
  }
}

package "Bootstrap" {
  class AirportBootstrapper <<bootstrap>> {
    + execute() : boolean
    - register(ctrl, icao, iata, name, town,\n country, lat, lon, elevation, areaCode) : void
  }
}

CreateAirportUI --> CreateAirportController : uses

CreateAirportController --> AirportRepository : uses
CreateAirportController --> AirControlAreaRepository : uses
CreateAirportController --> CountryRepository : uses
CreateAirportController ..> Airport : <<creates>>

Airport *-- ICAOCode
Airport *-- IATACode
Airport *-- AirportName
Airport *-- Country
Airport *-- AirportCoordinates
Airport *-- Elevation
Airport *-- AirControlAreaCode

JpaAirportRepository ..|> AirportRepository
InMemoryAirportRepository ..|> AirportRepository

AirportBootstrapper --> CreateAirportController : <<uses>>

@enduml
