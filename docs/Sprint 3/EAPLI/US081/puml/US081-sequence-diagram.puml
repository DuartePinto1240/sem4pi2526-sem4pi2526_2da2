@startuml
actor Pilot
participant ImportFlightPlanUI as UI <<boundary>>
participant ImportFlightPlanController as CTRL <<control>>
participant FlightPlanImporter as IMP <<service>>
participant ErrorCollector as ERR <<collector>>
participant FlightPlanSemanticVisitor as VIS <<visitor>>
participant FlightPlanBuilderListener as BLD <<listener>>
participant FlightPlanRepository as REPO <<repository>>

Pilot -> UI : doShow()
UI -> CTRL : availableFlightPlanFiles()
CTRL --> UI : List<File> (.fp files from flightplans/)
UI --> Pilot : shows numbered file list

Pilot -> UI : selects file number

note over UI
  UI also calls availableAircraftForPilot(pilotEmail)
  and lets pilot optionally select aircraft registration.
end note

UI -> CTRL : importFromFile(file, aircraftRegistration, pilotEmail)
activate CTRL

CTRL -> CTRL : check file.getName().endsWith(".fp")
alt not .fp extension
    CTRL --> UI : FlightPlanImportResult.failure("Unsupported file format")
    UI --> Pilot : error message
else .fp file
    CTRL -> IMP : importFromFile(path)
    activate IMP

    IMP -> ERR : registers as lexer error listener
    IMP -> IMP : FlightPlanLexer(input)

    IMP -> IMP : FlightPlanParser(tokens) → ParseTree

    alt has lexical or syntactic errors
        IMP --> CTRL : FlightPlanImportResult.failure(errors)
    else no errors so far
        IMP -> VIS : visit(tree)
        VIS -> ERR : addSemanticError(...) [if violations]

        alt has semantic errors
            IMP --> CTRL : FlightPlanImportResult.failure(errors)
        else all valid
            IMP -> BLD : ParseTreeWalker.walk(builder, tree)
            BLD -> BLD : builds FlightData + LegData + SegmentData\n(phase, altitudeMin, altitudeMax, from/to, width, wind)
            IMP --> CTRL : FlightPlanImportResult.success(flights, rawSource)
        end
    end

    deactivate IMP

    alt success
        loop for each FlightData fd
            CTRL -> CTRL : check existsByFlightId(fd.id) → skip if duplicate\n(adds to lastSkippedIds)
            loop for each LegData ld
                CTRL -> CTRL : new FlightLeg(dep, date, time, arr, time, fuel, unit)
                loop for each SegmentData sd
                    CTRL -> CTRL : new FlightSegment(fromLat, fromLon, toLat, toLon,\n  altitudeMin, altitudeMax, phase, width, windAngle, windSpeed)
                    CTRL -> CTRL : leg.addSegment(segment)
                end
            end
            CTRL -> CTRL : new FlightPlan(fd.id, fd.type, legs)
            CTRL -> CTRL : plan.setDslContent(rawSource)
            CTRL -> CTRL : plan.setAircraftRegistration(aircraftRegistration)
            CTRL -> CTRL : plan.setPilotEmail(pilotEmail)
            CTRL -> REPO : save(plan)
        end
        CTRL --> UI : result (success, lastSkippedIds)
        UI --> Pilot : displays summary\n(flightId, type, legs with airports and segment count,\nstatus=DRAFT, skipped IDs if any)
    else failure
        CTRL --> UI : result (errors)
        UI --> Pilot : displays all errors\n(type, line, column, message)
    end
end

deactivate CTRL
@enduml
