@startuml
skinparam classAttributeIconSize 0

package "LPROG" {
  class FlightPlanImporter <<service>> {
    +importFromFile(path: String): FlightPlanImportResult
    +importFromString(input: String): FlightPlanImportResult
    -runPipeline(input: String): FlightPlanImportResult
  }

  class FlightPlanImportResult <<result>> {
    -flights: List<FlightData>
    -errors: List<ValidationError>
    -rawSource: String
    +isSuccess(): boolean
    +getFlights(): List<FlightData>
    +getErrors(): List<ValidationError>
    +getRawSource(): String
    +{static} success(flights, raw): FlightPlanImportResult
    +{static} failure(errors): FlightPlanImportResult
  }

  class ErrorCollector <<listener>> {
    +addSemanticError(line, col, msg): void
    +hasErrors(): boolean
    +getErrors(): List<ValidationError>
  }

  class ValidationError <<value object>> {
    -type: ErrorType
    -line: int
    -column: int
    -message: String
    +getType(): ErrorType
    +getLine(): int
    +getColumn(): int
    +getMessage(): String
  }

  enum ErrorType <<enum>> {
    LEXICAL
    SYNTACTIC
    SEMANTIC
  }

  class FlightPlanSemanticVisitor <<visitor>> {
    +visitFlight(ctx): Void
    +visitLeg(ctx): Void
    +visitFuel(ctx): Void
    +visitSegment(ctx): Void
    +visitAirportCode(ctx): Void
  }

  class FlightPlanBuilderListener <<listener>> {
    +enterFlight(ctx): void
    +exitFlight(ctx): void
    +enterLeg(ctx): void
    +exitLeg(ctx): void
    +enterDeparture(ctx): void
    +enterArrival(ctx): void
    +enterFuel(ctx): void
    +enterSegment(ctx): void
    +exitSegment(ctx): void
    +getFlights(): List<FlightData>
  }

  class FlightData <<dto>> {
    +id: String
    +type: String
    +legs: List<LegData>
  }

  class LegData <<dto>> {
    +departureAirport: String
    +departureDate: String
    +departureTime: String
    +arrivalAirport: String
    +arrivalTime: String
    +fuelQuantity: double
    +fuelUnit: String
    +segments: List<SegmentData>
  }

  class SegmentData <<dto>> {
    +fromLat: double
    +fromLon: double
    +toLat: double
    +toLon: double
    +altitudeSlots: List<Double>
    +width: double
    +windAngle: double
    +windSpeed: double
  }
}

FlightPlanImporter ..> ErrorCollector
FlightPlanImporter ..> FlightPlanSemanticVisitor
FlightPlanImporter ..> FlightPlanBuilderListener
FlightPlanImporter ..> FlightPlanImportResult
FlightPlanImportResult "1" *-- "0..*" FlightData
FlightPlanImportResult "1" *-- "0..*" ValidationError
ValidationError --> ErrorType
FlightData "1" *-- "1..*" LegData
LegData "1" *-- "0..*" SegmentData

note right of FlightPlanBuilderListener
  enterSegment ctx.NUMBER() layout:
  [alt1..altN, width, windAngle, windSpeed]
  Coordinates via ctx.coordinates(0/1)
end note

note bottom of FlightPlanImporter
  importFromString: used by tests (no filesystem)
  importFromFile: production use
  rawSource preserved for EAPLI dslContent
end note
@enduml
