@startuml US103-class-diagram
skinparam classAttributeIconSize 0

package "C Simulation Layer" {

  class SimulationConfig <<data>> {
    +num_flights: int
    +time_step_seconds: int
    +total_steps: int
    +safety_threshold_m: double
    +max_violations: int
  }

  class FlightState <<data>> {
    +flight_id: int
    +pid: pid_t
    +pipe_read: int
    +pipe_step: int
    +current: Position
    +history: Position[MAX_HISTORY]
    +history_count: int
    +active: int
    +violated: int
  }

  class Position <<data>> {
    +latitude: double
    +longitude: double
    +altitude: double
    +time_step: int
  }

  class simulation_c <<module>> {
    +start_simulation(config, states, report): int
    +synchronize_step(states, num_flights, step): int
    +check_safety_violations(...): int
    +check_predicted_violations(...): int
    +validate_parameters(config): int
    +compute_distance(p1, p2): double
  }

  class flight_c <<module>> {
    +execute_flight(flight_id, pipe_write, pipe_step, total_steps, time_step): void
    +compute_next_position(flight_id, step, total_steps): Position
    +handle_sigusr1(sig): void
    +handle_sigterm(sig): void
  }

  class SimulationReport <<data>> {
    +total_flights: int
    +total_violations: int
    +pass: int
    +violations: ViolationEvent[MAX_VIOLATIONS]
    +flight_statuses: int[MAX_FLIGHTS]
  }

  class ViolationEvent <<data>> {
    +timestamp: double
    +flight_id_1: int
    +flight_id_2: int
    +position_1: Position
    +position_2: Position
    +velocity_1: VelocityVector
    +velocity_2: VelocityVector
  }
}

simulation_c ..> SimulationConfig : uses
simulation_c ..> FlightState : manages
simulation_c ..> SimulationReport : fills
simulation_c ..> flight_c : forks
flight_c ..> Position : computes
FlightState *-- Position : current / history
SimulationReport *-- ViolationEvent

note top of simulation_c
  US103 — synchronize_step() sends a
  step token via pipe_step and blocks
  until every active flight replies
  with its position update.
  True lockstep synchronization.
end note

note right of FlightState
  pipe_read: parent reads positions (up)
  pipe_step: parent writes tokens (down)
  Both pipes added for US103.
end note

@enduml
