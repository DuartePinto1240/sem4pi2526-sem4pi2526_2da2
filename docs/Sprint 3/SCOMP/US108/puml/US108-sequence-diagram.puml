@startuml
title US108 — Step Barrier Synchronisation Sequence

participant "SimulationController\n(thread)" as SC
participant "execute_flight(0)\n(child process)" as F0
participant "execute_flight(1)\n(child process)" as F1
participant "execute_flight(2)\n(child process)" as F2
participant "SharedMemory\n(shm)" as SHM

== Step N begins ==

SC -> F0 : sem_post(/flight_0)
SC -> F1 : sem_post(/flight_1)
SC -> F2 : sem_post(/flight_2)

activate F0
activate F1
activate F2

F0 -> SHM : positions[0] = pos\nsteps_completed[0]++
F1 -> SHM : positions[1] = pos\nsteps_completed[1]++
F2 -> SHM : positions[2] = pos\nsteps_completed[2]++

== Barrier entry (each flight) ==

F0 -> F0 : sem_wait(sem_nproc)\nnproc_at_barrier++ → 1\nsem_post(sem_nproc)
F0 -> F0 : sem_wait(sem_barrier)\nsem_post(sem_barrier)
note right of F0: nproc=1 < 3\nblocks at sem_wait

F1 -> F1 : sem_wait(sem_nproc)\nnproc_at_barrier++ → 2\nsem_post(sem_nproc)
F1 -> F1 : sem_wait(sem_barrier)\nsem_post(sem_barrier)
note right of F1: nproc=2 < 3\nblocks at sem_wait

F2 -> F2 : sem_wait(sem_nproc)\nnproc_at_barrier++ → 3\nsem_post(sem_nproc)
note right of F2: nproc=3 == num_active\nlast flight → sem_post(sem_barrier)
F2 -> SC : sem_post(sem_barrier)

== SimulationController unblocks ==

SC -> SC : sem_wait(sem_barrier) unblocks
SC -> SHM : nproc_at_barrier = 0
SC -> SC : sem_post(sem_barrier)\n[reopen for flights]
SC -> SHM : read positions[]\ncheck violations

F0 -> F0 : sem_wait unblocks\nsem_post(sem_barrier)
F1 -> F1 : sem_wait unblocks\nsem_post(sem_barrier)
F2 -> F2 : sem_wait unblocks\nsem_post(sem_barrier)

deactivate F0
deactivate F1
deactivate F2

note over SC: Step N complete.\nAll positions stable.\nAdvance to step N+1.

== Step N+1 begins ==

SC -> F0 : sem_post(/flight_0)
SC -> F1 : sem_post(/flight_1)
SC -> F2 : sem_post(/flight_2)

@enduml