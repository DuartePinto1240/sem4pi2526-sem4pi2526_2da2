@startuml
title US102 — C Layer: Safety Violation Detection and Signal Handling

participant "main_process" as MAIN
participant "flight_process_i" as FPI
participant "flight_process_j" as FPJ
participant "violation_log[]" as LOG

note over MAIN
  Called after all position
  updates received for
  the current time step
end note

MAIN -> MAIN : check_safety_violations(states, n, threshold)

loop [for each pair (i, j), i < j]
    MAIN -> MAIN : d = euclidean_distance(&states[i].current, &states[j].current)

    alt [d < safety_threshold]
        MAIN -> LOG : log_violation(step, i, j, &pos_i, &pos_j, d)
        activate LOG
        LOG --> MAIN : violation_count++
        deactivate LOG

        MAIN -> FPI : kill(pid_i, SIGUSR1)
        activate FPI
        FPI -> FPI : sigprocmask(SIG_BLOCK, all_signals, &old_mask)
        FPI -> FPI : fprintf(stderr, "SAFETY VIOLATION: step %d")
        FPI -> FPI : sigprocmask(SIG_SETMASK, &old_mask, NULL)
        deactivate FPI

        MAIN -> FPJ : kill(pid_j, SIGUSR1)
        activate FPJ
        FPJ -> FPJ : sigprocmask(SIG_BLOCK, all_signals, &old_mask)
        FPJ -> FPJ : fprintf(stderr, "SAFETY VIOLATION: step %d")
        FPJ -> FPJ : sigprocmask(SIG_SETMASK, &old_mask, NULL)
        deactivate FPJ

        alt [violation_count >= max_violations]
            MAIN -> MAIN : terminate_all_processes(states, n)
            MAIN -> FPI  : kill(pid_i, SIGTERM)
            MAIN -> FPJ  : kill(pid_j, SIGTERM)
            FPI -> FPI   : handle_sigterm(): cleanup, exit(1)
            FPJ -> FPJ   : handle_sigterm(): cleanup, exit(1)
            MAIN -> MAIN : waitpid() all children
        end
    end
end

@enduml