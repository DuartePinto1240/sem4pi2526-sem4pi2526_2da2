@startuml
actor "Flight Control Op." as FCO
participant SimulateAreaUI as UI <<boundary>>
participant SimulateAreaController as CTRL <<control>>
participant PersistenceContext as PC <<registry>>
participant FlightPlanRepository as FP_REPO <<repository>>
participant AirControlAreaRepository as AREA_REPO <<repository>>
participant "config:SimulationConfig" as CFG <<data>>
participant SimulationLauncher as LAUNCHER <<service>>
participant "result:SimulationResult" as RESULT <<data>>

FCO -> UI : doShow()
UI -> FCO : asks for areaId, flightPlanIds, timeStep, totalSteps, safetyThreshold
FCO -> UI : provides parameters

UI -> CTRL : startSimulation(areaId, flightPlanIds, timeStep, totalSteps, safetyThreshold)
activate CTRL

CTRL -> PC : getInstance()
PC --> CTRL : persistenceContext

CTRL -> AREA_REPO : ofIdentity(areaId)
activate AREA_REPO
AREA_REPO --> CTRL : Optional<AirControlArea>
deactivate AREA_REPO

CTRL -> FP_REPO : ofIdentity(flightPlanId) [for each]
activate FP_REPO
FP_REPO --> CTRL : Optional<FlightPlan>
deactivate FP_REPO

CTRL -> CTRL : validateParameters(area, flightPlans, timeStep, safetyThreshold)

alt [parameters invalid]
    CTRL --> UI : throw IllegalArgumentException
    UI --> FCO : show error "Invalid simulation parameters"
end

CTRL -> CFG : new SimulationConfig(numFlights, timeStep, totalSteps, safetyThreshold, areaId, flightPlanIds)
activate CFG
CFG --> CTRL : config
deactivate CFG

CTRL -> LAUNCHER : launchSimulation(config)
activate LAUNCHER

LAUNCHER -> LAUNCHER : buildCommand(config)
LAUNCHER -> LAUNCHER : ProcessBuilder.start()

note right of LAUNCHER
  Launches compiled C binary.
  C process:
  - forks one child per flight
  - communicates via pipes
  - sends SIGUSR1 on violations
  - tracks positions step by step
end note

LAUNCHER -> LAUNCHER : waitFor() C process
LAUNCHER -> RESULT : new SimulationResult(exitCode, outputLog)
activate RESULT
RESULT --> LAUNCHER : result
deactivate RESULT

LAUNCHER --> CTRL : result
deactivate LAUNCHER

CTRL --> UI : result
deactivate CTRL

alt [simulation successful]
    UI --> FCO : show success message with stats
else [simulation failed or violations exceeded]
    UI --> FCO : show failure message with violation details
end

@enduml