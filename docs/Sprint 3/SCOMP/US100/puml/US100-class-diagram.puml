@startuml
skinparam classAttributeIconSize 0

package "Presentation" {
  class SimulateAreaUI <<boundary>> {
    +doShow()
    +headline(): String
  }
}

package "Application" {
  class SimulateAreaController <<control>> {
    +startSimulation(config): SimulationResult
    +validateParameters(config): boolean
  }
}

package "C Simulation Layer" {
  class SimulationLauncher <<service>> {
    +launchSimulation(config): int
    +buildCommand(config): String[]
  }
  class SimulationConfig <<data>> {
    +numFlights: int
    +timeStepSeconds: int
    +totalSteps: int
    +safetyThresholdM: double
    +maxViolations: int
    +areaId: String
    +flightPlanIds: String[]
  }
  class SimulationResult <<data>> {
    +success: boolean
    +totalFlights: int
    +violations: int
    +exitCode: int
    +outputLog: String
  }
}

package "Domain" {
  class FlightPlan <<aggregate root>> {
    -id: String
    -status: enum
    +identity(): String
    +isValidated(): boolean
  }
  class AirControlArea <<aggregate root>> {
    -name: String
    -areaCode: AreaCode
    +identity(): AreaCode
  }
  interface FlightPlanRepository <<repository>> {
    +ofIdentity(id): Optional<FlightPlan>
    +findValidatedByArea(areaId): Iterable<FlightPlan>
  }
  interface AirControlAreaRepository <<repository>> {
    +ofIdentity(code): Optional<AirControlArea>
  }
}

package "Infrastructure.Persistence" {
  class PersistenceContext <<registry>> {
    {static} +getInstance(): PersistenceContext
    +flightPlanRepository(): FlightPlanRepository
    +airControlAreaRepository(): AirControlAreaRepository
  }
  class InMemoryFlightPlanRepository <<repository>> {
    +ofIdentity(id): Optional<FlightPlan>
    +findValidatedByArea(areaId): Iterable<FlightPlan>
  }
  class InMemoryAirControlAreaRepository <<repository>> {
    +ofIdentity(code): Optional<AirControlArea>
  }

  InMemoryFlightPlanRepository ..|> FlightPlanRepository
  InMemoryAirControlAreaRepository ..|> AirControlAreaRepository
}

SimulateAreaUI ..> SimulateAreaController
SimulateAreaController ..> PersistenceContext
SimulateAreaController ..> FlightPlanRepository
SimulateAreaController ..> AirControlAreaRepository
SimulateAreaController ..> SimulationConfig
SimulateAreaController ..> SimulationLauncher
SimulateAreaController ..> SimulationResult
SimulationLauncher ..> SimulationConfig
SimulationLauncher ..> SimulationResult
PersistenceContext ..> FlightPlanRepository
PersistenceContext ..> AirControlAreaRepository
FlightPlanRepository ..> FlightPlan
AirControlAreaRepository ..> AirControlArea

@enduml