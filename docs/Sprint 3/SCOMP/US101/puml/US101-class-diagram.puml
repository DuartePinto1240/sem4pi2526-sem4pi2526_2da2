@startuml US101-class-diagram
skinparam classAttributeIconSize 0

package "C Simulation Layer" {
  class Simulation <<module>> {
    +validate_parameters(config): int
    +start_simulation(config, states, report): int
    +read_all_positions(states, num_flights): int
    +check_safety_violations(states, n, threshold, report, ts): int
    +check_predicted_violations(states, n, threshold, report, ts): int
    +compute_distance(p1, p2): double
  }
  class Flight <<module>> {
    +execute_flight(flight_id, pipe_fd, steps, step_sec): void
  }
  class Report <<module>> {
    +write_report(report, filename): void
  }

  class FlightState <<data>> {
    +flight_id: int
    +pid: pid_t
    +pipe_fd: int
    +current: Position
    +history[MAX_HISTORY]: Position
    +history_count: int
    +active: int
    +violated: int
  }
  class Position <<data>> {
    +latitude: double
    +longitude: double
    +altitude: double
    +time_step: int
  }
  class SimulationConfig <<data>> {
    +num_flights: int
    +time_step_seconds: int
    +total_steps: int
    +safety_threshold_m: double
    +max_violations: int
  }
  class SimulationReport <<data>> {
    +total_flights: int
    +total_violations: int
    +pass: int
    +violations[MAX_VIOLATIONS]: ViolationEvent
    +flight_statuses[MAX_FLIGHTS]: int
  }
}

Simulation..> FlightState
Simulation ..> SimulationConfig
Simulation ..> SimulationReport
Simulation ..> Flight
Simulation ..> Report
FlightState *-- Position

@enduml
