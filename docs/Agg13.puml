@startuml US011_Agg_Simulation
title Agg · Simulation\nInvariant: >= 1 flight plan; time step must complete before advancing

actor "FlightControlOp" as FCO
participant "Simulation [root]" as Sim
participant "SafetyViolation [E]" as SV
participant "SimReport [E]" as SR

FCO -> Sim : startSimulation(flightPlanIds, params)
activate Sim

Sim --> FCO : flightPlans.size = 0 → invalid

alt [no flight plans]
    Sim --> FCO : throw EmptySimulationException
end

loop [per time step]
    Sim -> SV : advanceStep(positions)
    activate SV
    SV --> Sim : violation detected
    deactivate SV

    Sim -> SV : new SafetyViolation(ts, pos, vel)
    activate SV

    SV -> SR : logViolation(v)
    activate SR
    SR --> Sim : all flights updated → step done
    deactivate SR
    deactivate SV
end

Sim -> SR : generateReport(pass/fail)
activate SR
SR --> FCO : SimulationCompleted event
deactivate SR

deactivate Sim

note right of Sim
  Invariant:
  >= 1 flight plan
  sincronização de time step
end note

@enduml