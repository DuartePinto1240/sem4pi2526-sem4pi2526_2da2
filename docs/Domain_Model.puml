@startuml US010_DomainModel_Final
title Domain Model — AISafe (Final Version)

skinparam linetype ortho
skinparam class {
    BackgroundColor<<AggregateRoot>> #D0C8F8
    BorderColor<<AggregateRoot>> #534AB7

    BackgroundColor<<Entity>> #C2EAD8
    BorderColor<<Entity>> #0F6E56

    BackgroundColor<<ValueObject>> #FAE8C0
    BorderColor<<ValueObject>> #854F0B
}

' ─────────────────────────────
' USER
' ─────────────────────────────
package "User" {
    class User <<AggregateRoot>> {
        + email : Email
        + name : String
        + phoneNumber : String
    }

    class SecurityClearance <<ValueObject>> {
        + expiryDate : LocalDate
    }

    class SkillsAssessment <<ValueObject>> {
        + assessmentDate : LocalDate
    }

    class Role <<AggregateRoot>> {
        + name : String
    }

    User "1" *-- "1" SecurityClearance
    User "1" *-- "0..*" SkillsAssessment
    User "0..*" --> "1" Role
}

' ─────────────────────────────
' MANUFACTURER
' ─────────────────────────────
package "Manufacturer" {
    class Manufacturer <<AggregateRoot>> {
        + name : String
        + country : String
    }
}

' ─────────────────────────────
' ENGINE MODEL
' ─────────────────────────────
package "Engine Model" {
    class EngineModel <<AggregateRoot>> {
        + name : String
        + motorizationType : String
        + tsfc : double
    }

    class ThrustSpec <<ValueObject>> {
        + seaLevelThrust : double
        + cruiseThrust : double
    }

    EngineModel "1" *-- "1" ThrustSpec
    EngineModel "0..*" --> "1" Manufacturer
}

' ─────────────────────────────
' AIRCRAFT MODEL
' ─────────────────────────────
package "Aircraft Model" {
    class AircraftModel <<AggregateRoot>> {
        + modelId : String
        + type : String
    }

    class FlightCharacteristics <<ValueObject>> {
        + mtow : double
        + mzfw : double
        + maxFuelCapacity : double
        + serviceCeiling : double
        + cruiseSpeed : double
        + wingArea : double
        + cl : double
        + cd : double
    }

    AircraftModel "1" *-- "1" FlightCharacteristics
    AircraftModel "1" --> "1..*" EngineModel : certified
    AircraftModel "0..*" --> "1" Manufacturer
}

' ─────────────────────────────
' AIRCRAFT
' ─────────────────────────────
package "Aircraft" {
    class Aircraft <<AggregateRoot>> {
        + registration : String
    }

    class CabinConfiguration <<ValueObject>> {
        + seatsPerClass : Map
        + crewSize : int
    }

    class OperationalStatus <<ValueObject>> {
        + status : enum
    }

    Aircraft "1" *-- "1" CabinConfiguration
    Aircraft "1" *-- "1" OperationalStatus
    Aircraft "0..*" --> "1" AircraftModel
}

' ─────────────────────────────
' AIR TRANSPORT COMPANY
' ─────────────────────────────
package "Air Transport Company" {
    class AirTransportCompany <<AggregateRoot>> {
        + name : String
    }

    class CompanyCode <<ValueObject>> {
        + iata : String
        + icao : String
    }

    class ATCC <<Entity>> {
        + email : String
        + name : String
        + position : String
        + active : boolean
    }

    class Pilot <<Entity>> {
    }

    AirTransportCompany "1" *-- "1" CompanyCode
    AirTransportCompany "1" *-- "0..*" ATCC
    AirTransportCompany "1" *-- "0..*" Pilot
    AirTransportCompany "1" --> "0..*" Aircraft
}

Pilot --> User

' ─────────────────────────────
' AIR CONTROL AREA
' ─────────────────────────────
package "Air Control Area" {
    class AirControlArea <<AggregateRoot>> {
        + name : String
    }

    class AreaCode <<ValueObject>> {
        + code : String
    }

    class GeographicBoundary <<ValueObject>> {
        + polygon : List
    }

    AirControlArea "1" *-- "1" AreaCode
    AirControlArea "1" *-- "1" GeographicBoundary
}

' ─────────────────────────────
' AIRPORT
' ─────────────────────────────
package "Airport" {
    class Airport <<AggregateRoot>> {
        + name : String
        + town : String
        + country : String
        + altitude : double
    }

    class AirportCode <<ValueObject>> {
        + iata : String
        + icao : String
    }

    class Coordinates <<ValueObject>> {
        + latitude : double
        + longitude : double
    }

    Airport "1" *-- "1" AirportCode
    Airport "1" *-- "1" Coordinates
}

Airport --> AirControlArea

' ─────────────────────────────
' FLIGHT ROUTE
' ─────────────────────────────
package "Flight Route" {
    class FlightRoute <<AggregateRoot>> {
        + active : boolean
    }

    class RouteCode <<ValueObject>> {
        + airlineCode : String
        + number : int
    }

    FlightRoute "1" *-- "1" RouteCode
}

FlightRoute --> Airport : origin
FlightRoute --> Airport : destination
FlightRoute --> AirTransportCompany

' ─────────────────────────────
' FLIGHT
' ─────────────────────────────
package "Flight" {
    class Flight <<AggregateRoot>> {
        + type : enum
    }

    class FlightDesignator <<ValueObject>> {
        + airlineCode : String
        + number : int
        + suffix : Character
    }

    class FlightSchedule <<ValueObject>> {
        + departureDateTime : LocalDateTime
        + scheduledArrival : LocalDateTime
    }

    Flight "1" *-- "1" FlightDesignator
    Flight "1" *-- "1" FlightSchedule
}

Flight --> FlightRoute
Flight --> Aircraft
Flight --> Pilot

' ─────────────────────────────
' FLIGHT PLAN
' ─────────────────────────────
package "Flight Plan" {
    class FlightPlan <<AggregateRoot>> {
        + status : enum
    }

    class DslSource <<ValueObject>> {
        + rawText : String
    }

    class FlightLeg <<Entity>> {
        + fuelQuantity : double
    }

    class Segment <<Entity>> {
        + width : double
    }

    class NodeJunction <<ValueObject>> {
    }

    class CoordinatesVO <<ValueObject>> {
        + latitude : double
        + longitude : double
    }

    class WindCondition <<ValueObject>> {
        + directionAngle : double
        + speedMs : double
    }

    class AltitudeSlot <<ValueObject>> {
        + minAltitude : double
        + maxAltitude : double
        + width : double
    }

    FlightPlan "1" *-- "1" DslSource
    FlightPlan "1" *-- "1..*" FlightLeg

    FlightLeg "1" *-- "1..*" Segment
    FlightLeg --> Airport : departure
    FlightLeg --> Airport : arrival

    Segment "1" --> "1" NodeJunction : start
    Segment "1" --> "1" NodeJunction : end
    Segment "1" *-- "1" WindCondition
    Segment "1" *-- "1..*" AltitudeSlot
    Segment "1" *-- "2" CoordinatesVO
}

FlightPlan --> Flight

' ─────────────────────────────
' WEATHER
' ─────────────────────────────
package "Weather" {
    class WeatherData <<AggregateRoot>> {
        + date : LocalDate
    }

    class WeatherCondition <<ValueObject>> {
        + temperature : double
        + pressure : double
        + windSpeed : double
        + windDirection : double
    }

    WeatherData "1" *-- "1" WeatherCondition
}

WeatherData --> AirControlArea

' ─────────────────────────────
' SIMULATION
' ─────────────────────────────
package "Simulation" {
    class Simulation <<AggregateRoot>> {
        + status : enum
    }

    class SimulationParameters <<ValueObject>> {
        + timeRangeStart : LocalDateTime
        + timeRangeEnd : LocalDateTime
        + safetyThreshold : double
    }

    class SimulationReport <<Entity>> {
        + result : enum
        + totalFlights : int
    }

    class SafetyViolation <<Entity>> {
        + timestamp : LocalDateTime
    }

    class VelocityVector <<ValueObject>> {
        + vx : double
        + vy : double
        + vz : double
    }

    Simulation "1" *-- "1" SimulationParameters
    Simulation "1" *-- "1" SimulationReport
    SimulationReport "1" *-- "0..*" SafetyViolation
    SafetyViolation "1" *-- "1" VelocityVector
}

Simulation --> FlightPlan
Simulation --> AirControlArea
EngineModel "0..*" --> "1" Manufacturer : made by
AircraftModel "0..*" --> "1" Manufacturer : made by

@enduml