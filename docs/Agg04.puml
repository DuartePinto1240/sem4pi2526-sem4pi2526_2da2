@startuml US011_Agg05_AircraftModel
title Agg 4 · Aircraft model\nInvariant: compatible engine; no duplicates; min 1 engine

actor "BackofficeOp" as Op
participant "AircraftModel [root]" as AM
participant "CertifiedEngineRef [VO]" as Ref

Op -> AM : addCertifiedEngine(engineModelId)
activate AM

AM -> Ref : alreadyCertified(engineModelId)?
activate Ref
Ref --> AM : true
deactivate Ref

alt [already certified]
    AM --> Op : throw DuplicateEngineException
end

AM -> Ref : isTypeCompatible(engineType)?
activate Ref
Ref --> AM : true → add ref
deactivate Ref

AM --> Op : EngineAdded event

deactivate AM

note right of AM
  Invariant:
  sem duplicados
  tipo compatível
  mínimo 1 engine
end note

@enduml