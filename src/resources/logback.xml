<configuration>

    <!-- Suppress all Hibernate and framework logs from the console -->
    <logger name="org.hibernate"                                            level="OFF"/>
    <logger name="eapli.framework.infrastructure.repositories.impl.jpa"    level="OFF"/>
    <logger name="org.springframework"                                      level="OFF"/>
    <logger name="com.zaxxer"                                               level="OFF"/>

    <!-- Only show ERROR level and above from everything else -->
    <root level="ERROR">
        <appender-ref ref="CONSOLE"/>
    </root>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

</configuration>
